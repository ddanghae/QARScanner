            float _touchThreshold = _top - _height * zoneMinDepthPct / 100.0
            bool _invalid = close < _bottom
            bool _touch = bar_index > _createdBar and low <= _touchThreshold and high >= _bottom and not _invalid
            inBullOb := inBullOb or _touch
            if barClosed and _invalid
                box.delete(_b)
                array.remove(bullObBoxes, _i)
                array.remove(bullObCreatedBars, _i)

if array.size(bearObBoxes) > 0
    for _i = array.size(bearObBoxes) - 1 to 0
        box _b = array.get(bearObBoxes, _i)
        int _createdBar = array.get(bearObCreatedBars, _i)
        bool _expired = bar_index > box.get_right(_b)
        if _expired
            box.delete(_b)
            array.remove(bearObBoxes, _i)
            array.remove(bearObCreatedBars, _i)
        else
            float _top = box.get_top(_b)
            float _bottom = box.get_bottom(_b)
            float _height = math.max(_top - _bottom, syminfo.mintick)
            float _touchThreshold = _bottom + _height * zoneMinDepthPct / 100.0
            bool _invalid = close > _top
            bool _touch = bar_index > _createdBar and high >= _touchThreshold and low <= _top and not _invalid
            inBearOb := inBearOb or _touch
