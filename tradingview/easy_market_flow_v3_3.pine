// scanSym12 = input.symbol("BINANCE:BCHUSDT.P", "12", inline = "s12", group = groupS2)
// 
// groupS3 = "91C. 검색할 코인 13–16 · 기본값은 선물"
// scanUse13 = input.bool(true, "", inline = "s13", group = groupS3)
// scanSym13 = input.symbol("BINANCE:TRXUSDT.P", "13", inline = "s13", group = groupS3)
// scanUse14 = input.bool(true, "", inline = "s14", group = groupS3)
// scanSym14 = input.symbol("BINANCE:NEARUSDT.P", "14", inline = "s14", group = groupS3)
// scanUse15 = input.bool(true, "", inline = "s15", group = groupS3)
// scanSym15 = input.symbol("BINANCE:APTUSDT.P", "15", inline = "s15", group = groupS3)
// scanUse16 = input.bool(true, "", inline = "s16", group = groupS3)
// scanSym16 = input.symbol("BINANCE:INJUSDT.P", "16", inline = "s16", group = groupS3)

// ─────────────────────────────────────────────────────────────────────────────
// BASE CALCULATIONS
// ─────────────────────────────────────────────────────────────────────────────
bool barClosed = barstate.isconfirmed
bool confirmed = not confirmedOnly or barClosed
int effectiveEmaFastLen = math.min(emaFastLen, emaSlowLen)
int effectiveEmaSlowLen = math.max(emaFastLen, emaSlowLen)
// int effectiveScanTrendFastLen = math.min(scanTrendFastLen, scanTrendSlowLen)
// int effectiveScanTrendSlowLen = math.max(scanTrendFastLen, scanTrendSlowLen)
float atr = ta.atr(atrLen)
float emaFast = ta.ema(close, effectiveEmaFastLen)
float emaSlow = ta.ema(close, effectiveEmaSlowLen)
float vwapValue = ta.vwap(hlc3)
float volSma = ta.sma(volume, volumeLen)
float entryCandleRange = math.max(high - low, syminfo.mintick)
float entryBodyRatio = math.abs(close - open) / entryCandleRange
float entryCloseLocation = (close - low) / entryCandleRange
float entryVolumeRatio = na(volume) or na(volSma) or volSma <= 0 ? na : volume / volSma
float atrBaseline = ta.sma(atr, atrBaselineLen)
float entryAtrRatio = na(atrBaseline) or atrBaseline <= 0 ? na : atr / atrBaseline
float effectiveFvgTouchDepthPct = math.min(zoneMinDepthPct, math.max(0.0, fvgFillPct - 5.0))
bool structureAtrReady = structureBreakBufferAtr == 0 or not na(atr)
bool sweepAtrReady = sweepMinDepthAtr == 0 and sweepReturnBufferAtr == 0 or not na(atr)
float structureBreakBuffer = na(atr) ? 0.0 : atr * structureBreakBufferAtr
float sweepDepthBuffer = na(atr) ? 0.0 : atr * sweepMinDepthAtr
float sweepReturnBuffer = na(atr) ? 0.0 : atr * sweepReturnBufferAtr

bool emaBull = close > emaFast and emaFast > emaSlow
bool emaBear = close < emaFast and emaFast < emaSlow
bool volumeBull = volume > volSma * volumeMult and close > open
bool volumeBear = volume > volSma * volumeMult and close < open

plot(ema1Show ? ta.ema(close, ema1Len) : na, "EMA 1", color = color.new(ema1Color, 0), linewidth = ema1Width)
plot(ema2Show ? ta.ema(close, ema2Len) : na, "EMA 2", color = color.new(ema2Color, 0), linewidth = ema2Width)
plot(ema3Show ? ta.ema(close, ema3Len) : na, "EMA 3", color = color.new(ema3Color, 0), linewidth = ema3Width)
plot(ema4Show ? ta.ema(close, ema4Len) : na, "EMA 4", color = color.new(ema4Color, 0), linewidth = ema4Width)

float bbBasisVal = ta.sma(close, bbLen)
float bbDevVal = bbMult * ta.stdev(close, bbLen)
plotBbUpper = plot(bbShow ? bbBasisVal + bbDevVal : na, "BB 상단", color = color.new(bbColor, 0), linewidth = bbWidth)
plotBbBasis = plot(bbShow ? bbBasisVal : na, "BB 중앙", color = color.new(bbColor, 35), linewidth = 1)
plotBbLower = plot(bbShow ? bbBasisVal - bbDevVal : na, "BB 하단", color = color.new(bbColor, 0), linewidth = bbWidth)
fill(plotBbUpper, plotBbLower, color = bbShow and bbFill ? color.new(bbColor, 92) : na, title = "볼린저밴드 채우기")
plot(showVWAP ? vwapValue : na, "당일 평균 거래가격 (VWAP)", color = color.new(vwapColor, vwapTransparency), linewidth = vwapWidth,
     linestyle = vwapLineStyleInput == "점선" ? plot.linestyle_dashed : vwapLineStyleInput == "도트" ? plot.linestyle_dotted : plot.linestyle_solid)

// ─────────────────────────────────────────────────────────────────────────────
// HELPERS
// ─────────────────────────────────────────────────────────────────────────────
f_lineStyle(_style) =>
    _style == "점선" ? line.style_dashed : _style == "도트" ? line.style_dotted : line.style_solid

f_textSize(_size) =>
    _size == "아주 작게" ? size.tiny : _size == "작게" ? size.small : _size == "크게" ? size.large : size.normal

f_stars(_n) =>
    _n >= 5 ? "★★★★★" : _n == 4 ? "★★★★☆" : _n == 3 ? "★★★☆☆" : _n == 2 ? "★★☆☆☆" : "★☆☆☆☆"

f_tfState(_fastLen, _slowLen) =>
    float _fast = ta.ema(close, _fastLen)
    float _slow = ta.ema(close, _slowLen)
    close > _fast and _fast > _slow ? 1 : close < _fast and _fast < _slow ? -1 : 0

f_stateText(_state) =>
    beginnerView ? (_state == 1 ? "🟢 위쪽 흐름" : _state == -1 ? "🔵 아래쪽 흐름" : "⚪ 방향 혼합") :
     _state == 1 ? "▲ 상승 정렬" : _state == -1 ? "▼ 하락 정렬" : "• 혼조"

f_tfLabel(_tf) =>
    int _seconds = timeframe.in_seconds(_tf)
    int _minutes = int(_seconds / 60)
    _seconds < 60 ? str.tostring(_seconds) + "초" :
     _seconds < 3600 ? str.tostring(_minutes) + "분" :
     _seconds < 86400 and _minutes % 60 == 0 ? str.tostring(int(_minutes / 60)) + "시간" :
     _seconds < 86400 ? str.tostring(_minutes) + "분" :
     str.tostring(_seconds / 86400.0, "#.##") + "일"

f_stateColor(_state) =>
    _state == 1 ? color.new(bullColor, directionCellTransparency) : _state == -1 ? color.new(bearColor, directionCellTransparency) : color.new(panelAltColor, 0)

f_lastBearishCandle(_lookback) =>
    float _top = na
    float _bottom = na
    int _offset = na
    float _volRatio = na
    for _i = 1 to _lookback
        if close[_i] < open[_i]
            _top := high[_i]
            _bottom := low[_i]
            _offset := _i
            _volRatio := nz(volume[_i]) / math.max(nz(volSma[_i]), 1.0)
            break
    [_top, _bottom, _offset, _volRatio]

f_lastBullishCandle(_lookback) =>
    float _top = na
    float _bottom = na
    int _offset = na
    float _volRatio = na
    for _i = 1 to _lookback
        if close[_i] > open[_i]
            _top := high[_i]
            _bottom := low[_i]
            _offset := _i
            _volRatio := nz(volume[_i]) / math.max(nz(volSma[_i]), 1.0)
            break
    [_top, _bottom, _offset, _volRatio]

// [1] + lookahead_on is non-repainting only when the request is equal to or
// higher than the chart timeframe. Unsafe lower-TF requests are not used.
float chartTfSeconds = timeframe.in_seconds()
float trendTfSeconds = timeframe.in_seconds(tfTrend)
float structureTfSeconds = timeframe.in_seconds(tfStructure)
float entryTfSeconds = timeframe.in_seconds(tfEntry)
bool trendTfBad = trendTfSeconds < chartTfSeconds or trendTfSeconds < structureTfSeconds
bool structTfBad = structureTfSeconds < chartTfSeconds or structureTfSeconds < entryTfSeconds
bool entryTfBad = entryTfSeconds < chartTfSeconds
bool shockTfBad = timeframe.in_seconds(shockCalculationTf) < chartTfSeconds
bool mtfInvalid = trendTfBad or structTfBad or entryTfBad or (useShockBonus and shockTfBad)

int mtfTrendState = trendTfBad ? 0 : request.security(
     syminfo.tickerid, tfTrend, f_tfState(effectiveEmaFastLen, effectiveEmaSlowLen)[1],
     lookahead = barmerge.lookahead_on)

int mtfStructureState = structTfBad ? 0 : request.security(
     syminfo.tickerid, tfStructure, f_tfState(effectiveEmaFastLen, effectiveEmaSlowLen)[1],
     lookahead = barmerge.lookahead_on)

int mtfEntryState = entryTfBad ? 0 : request.security(
     syminfo.tickerid, tfEntry, f_tfState(effectiveEmaFastLen, effectiveEmaSlowLen)[1],
     lookahead = barmerge.lookahead_on)

float sixHourReturn = shockTfBad ? na : request.security(
     syminfo.tickerid,
     shockCalculationTf,
     not na(close[shockLookbackBars + 1]) and close[shockLookbackBars + 1] != 0 ? (close[1] / close[shockLookbackBars + 1] - 1.0) * 100.0 : na,
     lookahead = barmerge.lookahead_on)

float shockRsi = shockTfBad ? na : request.security(
     syminfo.tickerid,
     shockCalculationTf,
     ta.rsi(close, rsiLen)[1],
     lookahead = barmerge.lookahead_on)

bool longShock = not shockTfBad and sixHourReturn <= -shockPct and shockRsi <= rsiOversold
bool shortShock = not shockTfBad and sixHourReturn >= shockPct and shockRsi >= rsiOverbought

// ─────────────────────────────────────────────────────────────────────────────
// SWING STRUCTURE
// ─────────────────────────────────────────────────────────────────────────────
float swingPH = ta.pivothigh(high, swingLen, swingLen)
float swingPL = ta.pivotlow(low, swingLen, swingLen)

var float lastSwingHigh = na
var float lastSwingLow = na
var int lastSwingHighBar = na
var int lastSwingLowBar = na
var bool swingHighBroken = false
var bool swingLowBroken = false
var int swingBias = 0

// Equal high/low tracking
var float prevPivotHigh = na
var float prevPivotLow = na
var int prevPivotHighBar = na
var int prevPivotLowBar = na

var float eqHighLevel = na
var float eqLowLevel = na
var bool eqHighActive = false
var bool eqLowActive = false
var bool eqHighSwept = false
var bool eqLowSwept = false
var line eqHighLine = na
var line eqLowLine = na
var int eqHighActivatedBar = na
var int eqLowActivatedBar = na

if barClosed and not na(swingPH)
    int _pivotBar = bar_index - swingLen
    float _tol = nz(atr[swingLen], atr) * eqAtrTolerance
    if showEqualLevels and not na(prevPivotHigh) and math.abs(swingPH - prevPivotHigh) <= _tol
        eqHighLevel := (swingPH + prevPivotHigh) / 2.0
        eqHighActive := true
        eqHighSwept := false
        eqHighActivatedBar := bar_index
        if not na(eqHighLine)
            line.set_extend(eqHighLine, extend.none)
            line.set_x2(eqHighLine, bar_index)
            line.set_color(eqHighLine, color.new(panelMutedColor, math.min(100, equalLineTransparency + 47)))
        // Activate the level only on the confirmation bar to avoid backpainting.
        if showDetailVisuals
            eqHighLine := line.new(bar_index, eqHighLevel, bar_index + 1, eqHighLevel,
                 xloc = xloc.bar_index, extend = extend.right,
                 color = color.new(bearColor, equalLineTransparency), style = f_lineStyle(equalLineStyleInput), width = equalLineWidth)
            label.new(bar_index, eqHighLevel, "비슷한 고점  ◆",
                 xloc = xloc.bar_index, yloc = yloc.price,
                 style = label.style_label_down, color = color.new(bearColor, equalLineTransparency),
                 textcolor = color.white, size = f_textSize(zoneTextSizeInput))
        else
            eqHighLine := na
    prevPivotHigh := swingPH
    prevPivotHighBar := _pivotBar
    lastSwingHigh := swingPH
    lastSwingHighBar := _pivotBar
    swingHighBroken := false

if barClosed and not na(swingPL)
    int _pivotBar = bar_index - swingLen
    float _tol = nz(atr[swingLen], atr) * eqAtrTolerance
    if showEqualLevels and not na(prevPivotLow) and math.abs(swingPL - prevPivotLow) <= _tol
        eqLowLevel := (swingPL + prevPivotLow) / 2.0
        eqLowActive := true
        eqLowSwept := false
        eqLowActivatedBar := bar_index
        if not na(eqLowLine)
            line.set_extend(eqLowLine, extend.none)
            line.set_x2(eqLowLine, bar_index)
            line.set_color(eqLowLine, color.new(panelMutedColor, math.min(100, equalLineTransparency + 47)))
        // Activate the level only on the confirmation bar to avoid backpainting.
        if showDetailVisuals
            eqLowLine := line.new(bar_index, eqLowLevel, bar_index + 1, eqLowLevel,
                 xloc = xloc.bar_index, extend = extend.right,
                 color = color.new(bullColor, equalLineTransparency), style = f_lineStyle(equalLineStyleInput), width = equalLineWidth)
            label.new(bar_index, eqLowLevel, "비슷한 저점  ◆",
                 xloc = xloc.bar_index, yloc = yloc.price,
                 style = label.style_label_up, color = color.new(bullColor, equalLineTransparency),
                 textcolor = panelColor, size = f_textSize(zoneTextSizeInput))
        else
            eqLowLine := na
    prevPivotLow := swingPL
    prevPivotLowBar := _pivotBar
    lastSwingLow := swingPL
    lastSwingLowBar := _pivotBar
    swingLowBroken := false

bool bullSwingBreak = barClosed and structureAtrReady and not na(lastSwingHigh) and not swingHighBroken and close > lastSwingHigh + structureBreakBuffer
bool bearSwingBreak = barClosed and structureAtrReady and not na(lastSwingLow) and not swingLowBroken and close < lastSwingLow - structureBreakBuffer

bool bullSwingChoch = bullSwingBreak and swingBias == -1
bool bearSwingChoch = bearSwingBreak and swingBias == 1

if bullSwingBreak
    swingHighBroken := true
    swingBias := 1
    if showSwingStructure and showDetailVisuals
        int _safeStartBar = math.max(lastSwingHighBar, math.max(0, bar_index - 9999))
        line.new(_safeStartBar, lastSwingHigh, bar_index, lastSwingHigh,
             xloc = xloc.bar_index, color = color.new(bullColor, swingLineTransparency), style = f_lineStyle(swingLineStyleInput), width = swingLineWidth)
        label.new(bar_index, lastSwingHigh, bullSwingChoch ? "큰 흐름 전환  ▲" : "큰 고점 돌파  ▲",
             xloc = xloc.bar_index, yloc = yloc.price,
             style = label.style_label_up, color = color.new(bullColor, swingLineTransparency),
             textcolor = panelColor, size = f_textSize(zoneTextSizeInput))

if bearSwingBreak
    swingLowBroken := true
    swingBias := -1
    if showSwingStructure and showDetailVisuals
        int _safeStartBar = math.max(lastSwingLowBar, math.max(0, bar_index - 9999))
        line.new(_safeStartBar, lastSwingLow, bar_index, lastSwingLow,
             xloc = xloc.bar_index, color = color.new(bearColor, swingLineTransparency), style = f_lineStyle(swingLineStyleInput), width = swingLineWidth)
        label.new(bar_index, lastSwingLow, bearSwingChoch ? "큰 흐름 전환  ▼" : "큰 저점 이탈  ▼",
             xloc = xloc.bar_index, yloc = yloc.price,
             style = label.style_label_down, color = color.new(bearColor, swingLineTransparency),
             textcolor = color.white, size = f_textSize(zoneTextSizeInput))

// ─────────────────────────────────────────────────────────────────────────────
// INTERNAL STRUCTURE
// ─────────────────────────────────────────────────────────────────────────────
float internalPH = ta.pivothigh(high, internalLen, internalLen)
float internalPL = ta.pivotlow(low, internalLen, internalLen)

var float lastInternalHigh = na
var float lastInternalLow = na
var int lastInternalHighBar = na
var int lastInternalLowBar = na
var bool internalHighBroken = false
var bool internalLowBroken = false
var int internalBias = 0

if barClosed and not na(internalPH)
    lastInternalHigh := internalPH
    lastInternalHighBar := bar_index - internalLen
    internalHighBroken := false

if barClosed and not na(internalPL)
    lastInternalLow := internalPL
    lastInternalLowBar := bar_index - internalLen
    internalLowBroken := false

bool bullInternalBreak = barClosed and structureAtrReady and not na(lastInternalHigh) and not internalHighBroken and close > lastInternalHigh + structureBreakBuffer
bool bearInternalBreak = barClosed and structureAtrReady and not na(lastInternalLow) and not internalLowBroken and close < lastInternalLow - structureBreakBuffer

bool bullInternalChoch = bullInternalBreak and internalBias == -1
bool bearInternalChoch = bearInternalBreak and internalBias == 1
bool bullInternalBos = bullInternalBreak and not bullInternalChoch
bool bearInternalBos = bearInternalBreak and not bearInternalChoch

if bullInternalBreak
    internalHighBroken := true
    internalBias := 1
    if showInternalStructure and showDetailVisuals
        int _safeStartBar = math.max(lastInternalHighBar, math.max(0, bar_index - 9999))
        line.new(_safeStartBar, lastInternalHigh, bar_index, lastInternalHigh,
             xloc = xloc.bar_index, color = color.new(bullColor, internalLineTransparency), style = f_lineStyle(internalLineStyleInput), width = internalLineWidth)
        label.new(bar_index, lastInternalHigh, bullInternalChoch ? "작은 흐름 전환  ▲" : "작은 고점 돌파  ▲",
             xloc = xloc.bar_index, yloc = yloc.price,
             style = label.style_label_up, color = color.new(bullColor, internalLineTransparency),
             textcolor = panelColor, size = f_textSize(zoneTextSizeInput))

if bearInternalBreak
    internalLowBroken := true
    internalBias := -1
    if showInternalStructure and showDetailVisuals
        int _safeStartBar = math.max(lastInternalLowBar, math.max(0, bar_index - 9999))
        line.new(_safeStartBar, lastInternalLow, bar_index, lastInternalLow,
             xloc = xloc.bar_index, color = color.new(bearColor, internalLineTransparency), style = f_lineStyle(internalLineStyleInput), width = internalLineWidth)
        label.new(bar_index, lastInternalLow, bearInternalChoch ? "작은 흐름 전환  ▼" : "작은 저점 이탈  ▼",
             xloc = xloc.bar_index, yloc = yloc.price,
             style = label.style_label_down, color = color.new(bearColor, internalLineTransparency),
             textcolor = color.white, size = f_textSize(zoneTextSizeInput))

// ─────────────────────────────────────────────────────────────────────────────
// LIQUIDITY SWEEPS
// ─────────────────────────────────────────────────────────────────────────────
var int sweptSwingLowPivotBar = na
var int sweptSwingHighPivotBar = na

bool bullEqSweep = barClosed and sweepAtrReady and eqLowActive and not eqLowSwept and
     bar_index > eqLowActivatedBar and low < eqLowLevel - sweepDepthBuffer and close > eqLowLevel + sweepReturnBuffer
bool bearEqSweep = barClosed and sweepAtrReady and eqHighActive and not eqHighSwept and
     bar_index > eqHighActivatedBar and high > eqHighLevel + sweepDepthBuffer and close < eqHighLevel - sweepReturnBuffer

bool bullSwingSweep = barClosed and sweepAtrReady and not na(lastSwingLow) and not swingLowBroken and
     lastSwingLowBar != sweptSwingLowPivotBar and low < lastSwingLow - sweepDepthBuffer and close > lastSwingLow + sweepReturnBuffer

bool bearSwingSweep = barClosed and sweepAtrReady and not na(lastSwingHigh) and not swingHighBroken and
     lastSwingHighBar != sweptSwingHighPivotBar and high > lastSwingHigh + sweepDepthBuffer and close < lastSwingHigh - sweepReturnBuffer

if bullEqSweep
    eqLowSwept := true
    eqLowActive := false
    eqLowActivatedBar := na
    if not na(eqLowLine)
        line.set_extend(eqLowLine, extend.none)
        line.set_x2(eqLowLine, bar_index)
        line.set_color(eqLowLine, color.new(bullColor, math.min(100, equalLineTransparency + 44)))
        eqLowLine := na

if bearEqSweep
    eqHighSwept := true
    eqHighActive := false
    eqHighActivatedBar := na
    if not na(eqHighLine)
        line.set_extend(eqHighLine, extend.none)
        line.set_x2(eqHighLine, bar_index)
        line.set_color(eqHighLine, color.new(bearColor, math.min(100, equalLineTransparency + 44)))
        eqHighLine := na

if bullSwingSweep
    sweptSwingLowPivotBar := lastSwingLowBar

if bearSwingSweep
    sweptSwingHighPivotBar := lastSwingHighBar

// If equal liquidity is cleanly broken rather than swept, deactivate it.
if barClosed and eqLowActive and bar_index > eqLowActivatedBar and close < eqLowLevel
    eqLowActive := false
    eqLowActivatedBar := na
    if not na(eqLowLine)
        line.set_extend(eqLowLine, extend.none)
        line.set_x2(eqLowLine, bar_index)
        line.set_color(eqLowLine, color.new(panelMutedColor, math.min(100, equalLineTransparency + 50)))
        eqLowLine := na
if barClosed and eqHighActive and bar_index > eqHighActivatedBar and close > eqHighLevel
    eqHighActive := false
    eqHighActivatedBar := na
    if not na(eqHighLine)
        line.set_extend(eqHighLine, extend.none)
        line.set_x2(eqHighLine, bar_index)
        line.set_color(eqHighLine, color.new(panelMutedColor, math.min(100, equalLineTransparency + 50)))
        eqHighLine := na

bool bullSweepEvent = bullEqSweep or bullSwingSweep
bool bearSweepEvent = bearEqSweep or bearSwingSweep

bool showBullSweepShape = showLiquidity and showDetailVisuals and barClosed and bullSweepEvent
bool showBearSweepShape = showLiquidity and showDetailVisuals and barClosed and bearSweepEvent
plotshape(showBullSweepShape and zoneTextSizeInput == "아주 작게", title = "저점을 찍고 복귀 · 아주 작게",
     style = shape.labelup, location = location.belowbar,
     color = color.new(bullColor, signalLabelTransparency), textcolor = panelColor, size = size.tiny, text = "저점 복귀 ▲")
plotshape(showBullSweepShape and zoneTextSizeInput == "작게", title = "저점을 찍고 복귀 · 작게",
     style = shape.labelup, location = location.belowbar,
     color = color.new(bullColor, signalLabelTransparency), textcolor = panelColor, size = size.small, text = "저점 복귀 ▲")
plotshape(showBullSweepShape and zoneTextSizeInput == "보통", title = "저점을 찍고 복귀 · 보통",
     style = shape.labelup, location = location.belowbar,
     color = color.new(bullColor, signalLabelTransparency), textcolor = panelColor, size = size.normal, text = "저점 복귀 ▲")

plotshape(showBearSweepShape and zoneTextSizeInput == "아주 작게", title = "고점을 찍고 복귀 · 아주 작게",
     style = shape.labeldown, location = location.abovebar,
     color = color.new(bearColor, signalLabelTransparency), textcolor = color.white, size = size.tiny, text = "고점 복귀 ▼")
plotshape(showBearSweepShape and zoneTextSizeInput == "작게", title = "고점을 찍고 복귀 · 작게",
     style = shape.labeldown, location = location.abovebar,
     color = color.new(bearColor, signalLabelTransparency), textcolor = color.white, size = size.small, text = "고점 복귀 ▼")
plotshape(showBearSweepShape and zoneTextSizeInput == "보통", title = "고점을 찍고 복귀 · 보통",
     style = shape.labeldown, location = location.abovebar,
     color = color.new(bearColor, signalLabelTransparency), textcolor = color.white, size = size.normal, text = "고점 복귀 ▼")

// ─────────────────────────────────────────────────────────────────────────────
// FAIR VALUE GAPS
// ─────────────────────────────────────────────────────────────────────────────
var bullFvgBoxes = array.new_box(0)
var bearFvgBoxes = array.new_box(0)
var bullFvgCreatedBars = array.new_int(0)
var bearFvgCreatedBars = array.new_int(0)
var filledFvgBoxHistory = array.new_box(0)
int filledFvgHistoryLimit = math.min(maxFvgZones, 20)

bool bullFvgCreated = barClosed and showFVG and bar_index >= 2 and
     low > high[2] and (low - high[2]) >= atr * fvgMinAtr

bool bearFvgCreated = barClosed and showFVG and bar_index >= 2 and
     high < low[2] and (low[2] - high) >= atr * fvgMinAtr

if bullFvgCreated
    box _b = box.new(
         left = bar_index - 2, top = low,
         right = bar_index + fvgExtendBars, bottom = high[2],
         xloc = xloc.bar_index, extend = extend.none,
         border_color = color.new(bullFvgColor, showDetailVisuals ? zoneBorderTransparency : 100),
         border_width = zoneBorderWidth, border_style = f_lineStyle(zoneBorderStyleInput),
         bgcolor = color.new(bullFvgColor, showDetailVisuals ? zoneFillTransparency : 100),
         text = showDetailVisuals and showZoneText ? "가격 빈 구간  ▲" : "",
         text_color = color.new(bullFvgColor, showDetailVisuals ? zoneTextTransparency : 100),
         text_size = f_textSize(zoneTextSizeInput))
    array.push(bullFvgBoxes, _b)
    array.push(bullFvgCreatedBars, bar_index)
    if array.size(bullFvgBoxes) > maxFvgZones
        box.delete(array.shift(bullFvgBoxes))
        array.shift(bullFvgCreatedBars)

if bearFvgCreated
    box _b = box.new(
         left = bar_index - 2, top = low[2],
         right = bar_index + fvgExtendBars, bottom = high,
         xloc = xloc.bar_index, extend = extend.none,
         border_color = color.new(bearFvgColor, showDetailVisuals ? zoneBorderTransparency : 100),
         border_width = zoneBorderWidth, border_style = f_lineStyle(zoneBorderStyleInput),
         bgcolor = color.new(bearFvgColor, showDetailVisuals ? zoneFillTransparency : 100),
         text = showDetailVisuals and showZoneText ? "가격 빈 구간  ▼" : "",
         text_color = color.new(bearFvgColor, showDetailVisuals ? zoneTextTransparency : 100),
         text_size = f_textSize(zoneTextSizeInput))
    array.push(bearFvgBoxes, _b)
    array.push(bearFvgCreatedBars, bar_index)
    if array.size(bearFvgBoxes) > maxFvgZones
        box.delete(array.shift(bearFvgBoxes))
        array.shift(bearFvgCreatedBars)

bool inBullFvg = false
bool inBearFvg = false

if array.size(bullFvgBoxes) > 0
    for _i = array.size(bullFvgBoxes) - 1 to 0
        box _b = array.get(bullFvgBoxes, _i)
        int _createdBar = array.get(bullFvgCreatedBars, _i)
        bool _expired = bar_index > box.get_right(_b)
        if _expired
            box.delete(_b)
            array.remove(bullFvgBoxes, _i)
            array.remove(bullFvgCreatedBars, _i)
        else
            float _top = box.get_top(_b)
            float _bottom = box.get_bottom(_b)
            float _height = math.max(_top - _bottom, syminfo.mintick)
            float _touchThreshold = _top - _height * effectiveFvgTouchDepthPct / 100.0
            float _fillThreshold = _top - _height * fvgFillPct / 100.0
            bool _overlap = low <= _top and high >= _bottom
            bool _filled = bar_index > _createdBar and low <= _fillThreshold
            bool _touch = bar_index > _createdBar and _overlap and low <= _touchThreshold
            // 표시 보존 설정과 신호 유효성은 분리합니다. 완전히 채워진 구간은 다시 신호에 쓰지 않습니다.
            bool _validTouch = _touch and not _filled
            inBullFvg := inBullFvg or _validTouch
            if barClosed and _filled
                if deleteFilledFVG
                    box.delete(_b)
                else
                    box.set_right(_b, bar_index)
                    box.set_border_color(_b, color.new(panelMutedColor, showDetailVisuals ? math.max(0, inactiveZoneTransparency - 22) : 100))
                    box.set_bgcolor(_b, color.new(panelMutedColor, showDetailVisuals ? inactiveZoneTransparency : 100))
                    box.set_text(_b, showDetailVisuals and showZoneText ? "채워진 구간" : "")
                    box.set_text_color(_b, color.new(panelMutedColor, showDetailVisuals ? math.max(0, inactiveZoneTransparency - 59) : 100))
                    array.push(filledFvgBoxHistory, _b)
                    if array.size(filledFvgBoxHistory) > filledFvgHistoryLimit
                        box.delete(array.shift(filledFvgBoxHistory))
                array.remove(bullFvgBoxes, _i)
                array.remove(bullFvgCreatedBars, _i)

if array.size(bearFvgBoxes) > 0
    for _i = array.size(bearFvgBoxes) - 1 to 0
        box _b = array.get(bearFvgBoxes, _i)
        int _createdBar = array.get(bearFvgCreatedBars, _i)
