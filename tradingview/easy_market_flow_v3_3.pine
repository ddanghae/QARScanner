    for _i = array.size(bullObBoxes) - 1 to 0
        box _b = array.get(bullObBoxes, _i)
        int _createdBar = array.get(bullObCreatedBars, _i)
        bool _expired = bar_index > box.get_right(_b)
        if _expired
            box.delete(_b)
