//@version=6
indicator("QAR·ICT Scanner 연동 지표", shorttitle = "QAR·ICT Sync", overlay = true,
     max_lines_count = 50, max_labels_count = 50, max_boxes_count = 20)

// ============================================================================
// QARScanner(js/core/*, js/scanner/deep-scanner.js, js/config.js) 채점 로직을
// 그대로 옮긴 단일 심볼용 지표. 코인신호기에서 코인 클릭 → 트레이딩뷰 이동 시
// 같은 점수·단계·진입/손절/목표를 이 차트에서 그대로 확인하기 위함.
//
// 스캐너의 두 모드를 모두 포팅하고, 진입 구간을 서로 다르게 그린다.
//   모드 1 급락 반등(reversal) — 1h·15m·5m 구조/유동성 스윕 기반.
//     진입 구간 = 15분봉 FVG·오더블록 구간(보라 실선 박스), 진입 표시 = 삼각형.
//   모드 2 조기 포착(early) — 4h 기준 |14일 수익률|·|24시간 변동|·상장 경과일 3요인.
//     진입 구간 = 4h 박스(주황 점선 박스) + 박스 상단 돌파 밴드, 진입 표시 = 다이아몬드.
// 시간봉은 차트와 무관하게 QARScanner 와 동일하게 4h·1h·15m·5m 고정 사용.
//
// [데이터 한계] Binance taker buy/sell 체결량 분리는 TradingView 일반 심볼에서
// 얻을 수 없음. CVD·거래량Delta·흡수 추정은 캔들 내 종가 위치 기반 근사치이며
// 원본(QARScanner, 실제 taker 데이터) 과 값이 다를 수 있음 — 구조/유동성/FVG/OB/
// 리스크리워드/점수공식/골든크로스리테스트는 동일 공식 그대로 포팅됨.
// 모드 2 는 2026-07-26 재적합(변형 D) 이후 펀딩·미결제약정을 쓰지 않는다. 둘 다
// TradingView 에서 읽기 어려웠던 항목인데 다변량에서 기여가 0 으로 나와 스캐너에서도
// 빠졌다 — 이제 모드 2 는 스캐너와 계산이 완전히 같다(근사·생략 없음).
// 단, 상장 경과일만 일봉 개수로 세므로 차트 이력이 800일 미만이면 값이 짧게 나온다.
// ============================================================================

// ---- 입력 ----
grpMode = "스캔 모드 (QARScanner 필터 바와 동일)"
modeInput = input.string("둘 다", "모드", options = ["1 급락 반등", "2 조기 포착", "둘 다"],
     tooltip = "1 급락 반등 = 스캐너 reversal 모드(1h·15m·5m 구조/스윕). 2 조기 포착 = early 모드(4h |14일 수익률|·|24시간 변동|·상장 경과일). 진입 구간이 서로 다른 색·모양으로 그려진다. '둘 다' 는 두 구간을 함께 표시하고, 진입 표시는 먼저 조건이 맞는 쪽 하나만 잡는다(모드 1 우선).", group = grpMode)
showZones = input.bool(true, "진입 구간 박스 표시", group = grpMode)
useCoreGate = input.bool(true, "핵심 신호 소계 하한 적용 (스캐너와 동일)",
     tooltip = "모드 1 전용. 스윕·스윕회수·1h구조전환·FVG/OB 합 50점 중 40% 이상을 요구해, 쉬운 보조 항목만으로 총점이 올라 진입이 잡히는 것을 막는다. 끄면 총점만 본다. 모드 2 는 채점 3요인이 전부 검증 요인이라 소계 하한이 없다.", group = grpMode)

grpDir = "방향"
dirInput = input.string("자동(높은 점수)", "방향", options = ["자동(높은 점수)", "롱만", "숏만"], group = grpDir)

grpStrict = "채점 강도 (QARScanner 5단계와 동일)"
strictLevel = input.int(3, "강도 1(널널)~5(엄격)", minval = 1, maxval = 5, group = grpStrict)

grpDisp = "표시"
showPlan = input.bool(true, "진입/손절/목표 라인 표시", group = grpDisp)
showTable = input.bool(true, "요약 표 표시", group = grpDisp)
tablePosInput = input.string("왼쪽 위", "요약표 위치",
     options = ["왼쪽 위", "왼쪽 가운데", "왼쪽 아래", "오른쪽 위", "오른쪽 가운데", "오른쪽 아래", "가운데 위", "가운데 아래"], group = grpDisp)
tableSizeInput = input.string("작게", "요약표 크기", options = ["아주 작게", "작게", "보통", "크게"], group = grpDisp)

// ---- 진입 품질 필터 (손절 줄이기) ----
grpQuality = "진입 품질 필터 — 손절 잦으면 여기 강화"
useTrendFilter = input.bool(true, "4h 추세 정렬만 (롱=200선 위 / 숏=200선 아래)",
     tooltip = "역추세 진입을 막아 손절을 크게 줄임. 대신 진입 수가 준다.", group = grpQuality)
minStageInput = input.int(3, "최소 단계 (3=구조전환 확인 후 진입)", minval = 1, maxval = 4,
     tooltip = "1~2단계(매집·유동성회수)는 아직 구조 미확정이라 손절 확률이 높음. 3 이상 권장.", group = grpQuality)
cooldownBars = input.int(3, "손절 후 대기 봉수", minval = 0, maxval = 50,
     tooltip = "손절 직후 같은 자리에서 반복 진입해 연속 손절나는 것을 방지.", group = grpQuality)
minRRInput = input.float(1.5, "최소 손익비", minval = 0.5, maxval = 10, step = 0.1,
     tooltip = "손익비가 이 값 미만이면 진입하지 않음.", group = grpQuality)
entryScoreMin = input.int(0, "진입 최소 점수 (0=강도 기준 자동)", minval = 0, maxval = 100,
     tooltip = "진입 표시 개수를 늘렸다 줄였다 하는 값. 0이면 위 '채점 강도'가 자동으로 문턱을 정합니다. 1 이상 직접 넣으면 그 값이 진입 문턱이 됩니다. 낮출수록 진입 표시가 많아지고, 높일수록 적어집니다.", group = grpQuality)
minEntryGap = input.int(0, "최소 진입 간격 (봉수, 0=제한 없음)", minval = 0, maxval = 200,
     tooltip = "진입 표시 사이 간격을 조절. 값을 키우면 진입이 더 띄엄띄엄(적게), 0이면 조건 맞을 때마다 표시. 화면이 진입 화살표로 너무 빽빽하면 이 값을 키우세요.", group = grpQuality)
useNoiseFilter = input.bool(true, "잡신호(노이즈) 걸러내기",
     tooltip = "스캐너와 동일: 방향 없는 횡보(촙) 구간이나 거래량 죽은 구간의 진입을 막습니다. 스캐너 결과와 맞추려면 켜두세요.", group = grpQuality)
noiseChopMax = input.float(61.8, "횡보(촙) 제외 기준", minval = 0, maxval = 100,
     tooltip = "Choppiness Index 가 이 값을 넘으면 횡보로 보고 진입 제외. 낮출수록 더 엄격(추세일 때만). 스캐너 기본 61.8.", group = grpQuality)
noiseMinRelVol = input.float(0.6, "최소 상대 거래량", minval = 0, maxval = 5, step = 0.1,
     tooltip = "상대 거래량이 이 값 미만이면 거래 죽은 구간으로 보고 진입 제외. 스캐너 기본 0.6.", group = grpQuality)

// ---- 강도 프리셋 (config.js STRICTNESS_LEVELS 포팅, 3단계 = 원본 기본값) ----
f_penalties(lvl) =>
    float pOverExt  = lvl == 1 ? -5.0  : lvl == 2 ? -7.0  : lvl == 3 ? -12.0 : lvl == 4 ? -16.0 : -19.0
    float pFarLow   = lvl == 1 ? -4.0  : lvl == 2 ? -6.0  : lvl == 3 ? -10.0 : lvl == 4 ? -13.0 : -16.0
    float pResAbove = lvl == 1 ? -3.0  : lvl == 2 ? -5.0  : lvl == 3 ? -8.0  : lvl == 4 ? -10.0 : -13.0
    float pTgtDist  = lvl == 1 ? -3.0  : lvl == 2 ? -5.0  : lvl == 3 ? -8.0  : lvl == 4 ? -10.0 : -13.0
    float pLowVol   = lvl == 1 ? -4.0  : lvl == 2 ? -6.0  : lvl == 3 ? -10.0 : lvl == 4 ? -13.0 : -16.0
    float pDown4h   = lvl == 1 ? -3.0  : lvl == 2 ? -5.0  : lvl == 3 ? -8.0  : lvl == 4 ? -10.0 : -13.0
    float pNewList  = lvl == 1 ? -2.0  : lvl == 2 ? -4.0  : lvl == 3 ? -6.0  : lvl == 4 ? -8.0  : -10.0
    float pPoorRR   = lvl == 1 ? -4.0  : lvl == 2 ? -6.0  : lvl == 3 ? -10.0 : lvl == 4 ? -13.0 : -16.0
    [pOverExt, pFarLow, pResAbove, pTgtDist, pLowVol, pDown4h, pNewList, pPoorRR]

// 실측 최고점이 60 이라 예전 30/40/55/65/75 는 4·5단계가 항상 0건이었다(커밋 66dac81).
// 등급 경계와 1:1 로 맞춘 값.
f_minScore(lvl) =>
    lvl == 1 ? 20.0 : lvl == 2 ? 25.0 : lvl == 3 ? 30.0 : lvl == 4 ? 40.0 : 55.0

// 진입 문턱: 직접 지정(entryScoreMin>0)이면 그 값, 아니면 강도 기준 자동
minScoreThresh = entryScoreMin > 0 ? entryScoreMin : f_minScore(strictLevel)
[pOverExt, pFarLow, pResAbove, pTgtDist, pLowVol, pDown4h, pNewList, pPoorRR] = f_penalties(strictLevel)

// 가중치 (config.js scoreWeights, 합계 100 — 고정, 조정 UI 없음)
wDrop = 10.0
wVol = 10.0
wSweep = 15.0
wRecover = 10.0
wAbsorb = 10.0
wStruct = 15.0
wFvgOb = 10.0
wDelta = 10.0
wEntry5m = 5.0
wRR = 5.0

// 골든크로스 리테스트 임계값 (config.js goldenCrossRetest)
GC_CROSS_LOOKBACK = 60
GC_IMPULSE_LOOKBACK = 30
GC_IMPULSE_MARGIN_PCT = 5.0
GC_ZONE_ATR_RATIO = 1.5
GC_REJECT_WICK = 0.3
GC_REJECT_CLOSEPOS = 0.5

SWING_LEN = 5
EQUAL_TOL_ATR = 0.1
NOISE_CHOP_PERIOD = 14  // Choppiness Index 기간 (config.noiseFilter.choppinessPeriod)

// 손절 최소 폭 (config.riskReward.minStopPct) — 저변동성 종목에서 손절이 진입에 붙어
// 손익비가 1:30 까지 폭주하던 것을 막는다. 스프레드·슬리피지 감안 시 성립하지 않는 손절이다.
MIN_STOP_PCT = 0.5

// 핵심 소계 하한 (config.reversalCoreMinPct / earlyCoreMinPct — 둘 다 40)
CORE_MIN_PCT = 40.0

// ---- 조기 포착(모드 2) 상수 — config.earlyDetect / earlyScoreWeights ----
// 2026-07-26 재적합(변형 D). 57,720행 시간순 70/30 분할, 학습셋에서만 변형 선택.
// 검증셋 상위3 리프트 10.71x (기존 5요인 6.04x). 원자료·재현: QARScanner/research/
// 압축·거래량 고갈·미결제약정·박스 위치·장기선은 전부 뺐다 — 다변량에서 기여가 0 이었다.
E_BOX_LOOKBACK = 60     // 박스 판정 봉 수 (4h × 60 ≈ 10일) — 채점 아님, 구간 표시용
E_MOM_BARS = 84         // 14일 = 4시간봉 84봉
E_DEAD_ZONE = 15.0      // |14일 수익률| 이 % 미만 = momentum 0점
E_MOM_FULL = 60.0       // 이 % 이상이면 momentum 만점
E_CHG_MIN = 5.0         // |24시간 변동| 이 % 이상부터 가점
E_CHG_FULL = 20.0       // 이 % 이상이면 change24h 만점
E_FRESH_FULL = 200.0    // 상장 이 일수 이하 = freshness 만점
E_FRESH_ZERO = 800.0    // 이 일수 이상 = 0점
E_AGE_UNKNOWN = 400.0   // 상장일 미상 대체값 (재적합에서 쓴 값)
E_MIN_QUOTE_VOL = 5000000.0  // 24h 거래대금 이 값 미만이면 감점
E_BREAK_REL_VOL = 2.0   // 3단계 돌파 상대거래량
E_BREAK_MAX_RUN = 15.0  // 3단계 돌파 후 상승폭 상한 %
E_PUMPED_MAX = 40.0     // 24h 이 % 초과 = 이미 급등, 제외
E_MIN_SCORE = 40.0      // early 표시 하한 (config.earlyMinScore) — reversal 의 강도 문턱과 별개
E_STOP_ATR = 4.0        // 손절 = 진입 - ATR × 이 배수 (격자 탐색 결과, 박스 기준 폐기)
E_TARGET_R = 4.0        // 주 목표(tp2) = 리스크 × 이 배수
E_PARTIAL_R = 1.0       // 이 배수에서 일부 익절 + 손절을 본전으로 (MFE 측정, config 주석 참고)

EW_MOM = 45.0           // |14일 수익률| (U자 — 크게 오르거나 크게 빠진 쪽)
EW_CHG = 32.0           // |24시간 변동|
EW_FRESH = 23.0         // 신규 상장일수록 가점
EP_THIN = -10.0         // 거래대금 부족

// ---- 배열 유틸 ----
f_nearestAbove(arr, price) =>
    float best = na
    if array.size(arr) > 0
        for i = 0 to array.size(arr) - 1
            float v = array.get(arr, i)
            if v > price and (na(best) or v < best)
                best := v
    best

f_nearestBelow(arr, price) =>
    float best = na
    if array.size(arr) > 0
        for i = 0 to array.size(arr) - 1
            float v = array.get(arr, i)
            if v < price and (na(best) or v > best)
                best := v
    best

f_arrHasCluster(arr, level, tol) =>
    int cnt = 0
    if not na(level) and array.size(arr) > 0
        for i = 0 to array.size(arr) - 1
            if math.abs(array.get(arr, i) - level) <= tol
                cnt += 1
    cnt >= 2

f_arrIncludes(arr, val) =>
    bool found = false
    if array.size(arr) > 0
        for i = 0 to array.size(arr) - 1
            if array.get(arr, i) == val
                found := true
    found

// ---- TF 공통 분석 — 1h·15m·5m 각각 request.security 로 호출 ----
// 구조(BOS/CHoCH)·유동성 스윕·목표가·저항/지지 클러스터·거래량/지표 일괄 반환.
f_coreTF() =>
    float atrVal = ta.atr(14)
    float avgVol = ta.sma(volume, 20)
    float relVol = not na(avgVol) and avgVol > 0 ? volume / avgVol : na
    float rsiVal = ta.rsi(close, 14)
    float ema20v = ta.ema(close, 20)
    float vwapVal = ta.vwap(hlc3)

    var array<float> swHighArr = array.new<float>(0)
    var array<float> swLowArr = array.new<float>(0)
    var array<string> highLabels = array.new<string>(0)
    var array<string> lowLabels = array.new<string>(0)
    var float lastPivHigh = na
    var float lastPivLow = na
    var string lastLabel = na

    float ph = ta.pivothigh(SWING_LEN, SWING_LEN)
    float pl = ta.pivotlow(SWING_LEN, SWING_LEN)

    if not na(ph)
        string lbl = na(lastPivHigh) ? na : (ph > lastPivHigh ? "HH" : "LH")
        lastPivHigh := ph
        array.push(swHighArr, ph)
        if array.size(swHighArr) > 20
            array.shift(swHighArr)
        if not na(lbl)
            array.push(highLabels, lbl)
            if array.size(highLabels) > 15
                array.shift(highLabels)
            lastLabel := lbl

    if not na(pl)
        string lbl2 = na(lastPivLow) ? na : (pl > lastPivLow ? "HL" : "LL")
        lastPivLow := pl
        array.push(swLowArr, pl)
        if array.size(swLowArr) > 20
            array.shift(swLowArr)
        if not na(lbl2)
            array.push(lowLabels, lbl2)
            if array.size(lowLabels) > 15
                array.shift(lowLabels)
            lastLabel := lbl2

    // BOS/CHoCH 상태 기계 (JS market-structure.detectStructureEvents 를 봉 단위 증분으로 재구성)
    var string bias = na
    var float refHigh = na
    var float refLow = na
    var int lastEventDir = 0 // 0=이벤트 없음, 1=상승, -1=하락 (bool+na 조합 대신 int 상태값 사용)
    var bool lastEventChoch = false

    if not na(ph)
        refHigh := ph
    if not na(pl)
        refLow := pl

    if not na(refHigh) and close > refHigh
        lastEventChoch := bias == "bear"
        bias := "bull"
        lastEventDir := 1
        refHigh := na
    if not na(refLow) and close < refLow
        lastEventChoch := bias == "bull"
        bias := "bear"
        lastEventDir := -1
        refLow := na

    bool bullishShift = lastEventDir == 1
    bool bearishShift = lastEventDir == -1
    bool choch = lastEventChoch
    bool firstHH = f_arrIncludes(highLabels, "HH")
    bool firstHL = f_arrIncludes(lowLabels, "HL")

    // 유동성 스윕 (저점/고점, lookback 6봉) — core/liquidity.detectLowSweep·detectHighSweep 포팅
    float priorLow = array.size(swLowArr) > 0 ? array.get(swLowArr, array.size(swLowArr) - 1) : na
    float priorHigh = array.size(swHighArr) > 0 ? array.get(swHighArr, array.size(swHighArr) - 1) : na

    int lowSweepOff = -1
    float lowSweepCandleLow = na
    if not na(priorLow)
        for k = 6 to 1
            if low[k] < priorLow and close[k] > priorLow
                lowSweepOff := k
                lowSweepCandleLow := low[k]
                break
    bool lowSweepExists = lowSweepOff >= 0
    bool lowSweepBroken = false
    if lowSweepExists
        for k = lowSweepOff - 1 to 0
            if low[k] < lowSweepCandleLow
                lowSweepBroken := true
                break
    bool lowSweepRecovered = not na(priorLow) and close > priorLow
    bool lowSweepValid = lowSweepExists and not lowSweepBroken and lowSweepRecovered

    int highSweepOff = -1
    float highSweepCandleHigh = na
    if not na(priorHigh)
        for k = 6 to 1
            if high[k] > priorHigh and close[k] < priorHigh
                highSweepOff := k
                highSweepCandleHigh := high[k]
                break
    bool highSweepExists = highSweepOff >= 0
    bool highSweepBroken = false
    if highSweepExists
        for k = highSweepOff - 1 to 0
            if high[k] > highSweepCandleHigh
                highSweepBroken := true
                break
    bool highSweepRecovered = not na(priorHigh) and close < priorHigh
    bool highSweepValid = highSweepExists and not highSweepBroken and highSweepRecovered

    float nearestHighAbove = f_nearestAbove(swHighArr, close)
    float nearestLowBelow = f_nearestBelow(swLowArr, close)
    float clusterTol = atrVal * EQUAL_TOL_ATR
    bool eqHighNear = not na(nearestHighAbove) and f_arrHasCluster(swHighArr, nearestHighAbove, clusterTol) and (nearestHighAbove - close) / atrVal < 1
    bool eqLowNear = not na(nearestLowBelow) and f_arrHasCluster(swLowArr, nearestLowBelow, clusterTol) and (close - nearestLowBelow) / atrVal < 1

    // 급락/급등 근사(1h 에서만 의미 있음, 다른 TF 호출에선 그냥 무시됨)
    float change6h = close[6] != 0 ? (close - close[6]) / close[6] * 100 : na

    // 최근 확정 스윙 저/고 (없으면 현재 봉 저/고로 폴백) — pctFromRecentLow/High·스탑로스 계산에 사용
    float recentLowRaw = not na(lastPivLow) ? lastPivLow : low
    float recentHighRaw = not na(lastPivHigh) ? lastPivHigh : high
    float nearLowPct = recentLowRaw != 0 ? (close - recentLowRaw) / recentLowRaw * 100 : 0
    float nearHighPct = recentHighRaw != 0 ? (recentHighRaw - close) / recentHighRaw * 100 : 0

    float volTrendAvgRel = ta.sma(relVol, 5)

    [close, atrVal, avgVol, relVol, rsiVal, ema20v, vwapVal,
     bullishShift, choch, firstHH, firstHL,
     lowSweepExists, lowSweepValid, lowSweepRecovered,
     highSweepExists, highSweepValid, highSweepRecovered,
     nearestHighAbove, nearestLowBelow, eqHighNear, eqLowNear,
     change6h, nearLowPct, nearHighPct, volTrendAvgRel,
     recentLowRaw, recentHighRaw, lastLabel, bearishShift]

// ---- 15분봉 전용 — FVG·오더블록·CVD근사·흡수 캔들 요약 ----
f_extra15() =>
    float atrVal = ta.atr(14)
    float minAtrGap = atrVal * 0.05

    var float fvgBullLow = na
    var float fvgBullHigh = na
    var float fvgBearLow = na
    var float fvgBearHigh = na

    float a2h = high[2]
    float a2l = low[2]
    if a2h < low
        float gapLow = a2h
        float gapHigh = low
        float sz = gapHigh - gapLow
        float mid = (gapHigh + gapLow) / 2
        float pct = mid != 0 ? sz / mid * 100 : 0.0
        if sz >= minAtrGap and pct >= 0.15
            fvgBullLow := gapLow
            fvgBullHigh := gapHigh
    if a2l > high
        float gapLow2 = high
        float gapHigh2 = a2l
        float sz2 = gapHigh2 - gapLow2
        float mid2 = (gapHigh2 + gapLow2) / 2
        float pct2 = mid2 != 0 ? sz2 / mid2 * 100 : 0.0
        if sz2 >= minAtrGap and pct2 >= 0.15
            fvgBearLow := gapLow2
            fvgBearHigh := gapHigh2

    if not na(fvgBullLow) and low <= fvgBullLow
        fvgBullLow := na
        fvgBullHigh := na
    if not na(fvgBearHigh) and high >= fvgBearHigh
        fvgBearLow := na
        fvgBearHigh := na

    // 오더블록 — 위 f_coreTF 와 별개로 15m 자체 구조전환을 가볍게 추적(함수 독립성 유지)
    var float obRefHigh = na
    var float obRefLow = na
    var float obBullLow = na
    var float obBullHigh = na
    var float obBearLow = na
    var float obBearHigh = na

    float ph2 = ta.pivothigh(SWING_LEN, SWING_LEN)
    float pl2 = ta.pivotlow(SWING_LEN, SWING_LEN)
    if not na(ph2)
        obRefHigh := ph2
    if not na(pl2)
        obRefLow := pl2

    if not na(obRefHigh) and close > obRefHigh
        if close[1] < open[1]
            obBullLow := math.min(open[1], math.min(close[1], low[1]))
            obBullHigh := math.max(open[1], math.max(close[1], high[1]))
        obRefHigh := na
    if not na(obRefLow) and close < obRefLow
        if close[1] > open[1]
            obBearLow := math.min(open[1], math.min(close[1], low[1]))
            obBearHigh := math.max(open[1], math.max(close[1], high[1]))
        obRefLow := na

    if not na(obBullLow) and close < obBullLow
        obBullLow := na
        obBullHigh := na
    if not na(obBearHigh) and close > obBearHigh
        obBearLow := na
        obBearHigh := na

    // CVD·Delta 근사 — 실제 taker 데이터 없음(데이터 한계, 상단 주석 참고). 캔들 내 종가 위치로 매수비중 추정.
    float rng = high - low
    float buyRatio = rng > 0 ? (close - low) / rng : 0.5
    float deltaApprox = volume * (buyRatio - (1 - buyRatio))
    var float cvdAcc = 0.0
    cvdAcc += deltaApprox
    float cvdSlope = cvdAcc - cvdAcc[10]

    float avgVol15 = ta.sma(volume, 20)
    float lowerWickRatio = rng > 0 ? (math.min(open, close) - low) / rng : 0.0
    float upperWickRatio = rng > 0 ? (high - math.max(open, close)) / rng : 0.0
    float closePos = rng > 0 ? (close - low) / rng : 0.5
    float sellRatioProxy = 1 - buyRatio
    bool highVol = avgVol15 > 0 and volume / avgVol15 >= 1.2

    // Choppiness Index (core/noise-filter.js 포팅) — 횡보 강도. 높을수록 촙. (거래량 노이즈는 volTrend15 재사용)
    float ciRange = ta.highest(high, NOISE_CHOP_PERIOD) - ta.lowest(low, NOISE_CHOP_PERIOD)
    float ciSumTr = math.sum(ta.tr(true), NOISE_CHOP_PERIOD)
    float chopIndex = (ciRange > 0 and ciSumTr > 0) ? 100 * math.log10(ciSumTr / ciRange) / math.log10(NOISE_CHOP_PERIOD) : na

    [fvgBullLow, fvgBullHigh, fvgBearLow, fvgBearHigh,
     obBullLow, obBullHigh, obBearLow, obBearHigh,
     cvdSlope, deltaApprox, upperWickRatio, lowerWickRatio, closePos, sellRatioProxy, highVol,
     chopIndex]

// ---- 4시간봉 — 추세 필터 + 골든크로스 리테스트 (core/golden-cross-retest.js 포팅) ----
f_trend4h() =>
    float c = close
    float e50 = ta.ema(close, 50)
    float e200 = ta.ema(close, 200)
    float rsiVal = ta.rsi(close, 14)
    float atrVal = ta.atr(14)

    int crossOffset = -1
    for off = 1 to GC_CROSS_LOOKBACK
        if not na(e50[off]) and not na(e200[off]) and not na(e50[off + 1]) and not na(e200[off + 1])
            if e50[off + 1] <= e200[off + 1] and e50[off] > e200[off]
                crossOffset := off
                break

    bool impulseFound = false
    if crossOffset >= 0
        for off = crossOffset to crossOffset + GC_IMPULSE_LOOKBACK
            if not na(e200[off]) and close[off] > e200[off] * (1 + GC_IMPULSE_MARGIN_PCT / 100)
                impulseFound := true
                break

    bool heldAbove200 = true
    if crossOffset >= 0
        for off = crossOffset to 0
            if not na(e200[off]) and close[off] < e200[off]
                heldAbove200 := false
                break

    int retestOffset = -1
    if crossOffset >= 0 and impulseFound and heldAbove200
        for off = crossOffset to 0
            if not na(e50[off]) and not na(e200[off])
                float zoneLo = math.min(e50[off], e200[off]) - atrVal * GC_ZONE_ATR_RATIO
                float zoneHi = math.max(e50[off], e200[off]) + atrVal * GC_ZONE_ATR_RATIO
                if low[off] <= zoneHi and low[off] >= zoneLo
                    retestOffset := off
                    break

    int rejectOffset = -1
    if retestOffset >= 0
        for off = retestOffset to 0
            float rng = high[off] - low[off]
            if rng > 0 and not na(e200[off])
                float upperWick = (high[off] - math.max(open[off], close[off])) / rng
                float closePosR = (close[off] - low[off]) / rng
                if upperWick >= GC_REJECT_WICK and closePosR <= GC_REJECT_CLOSEPOS and close[off] > e200[off]
                    rejectOffset := off

    bool gcDetected = crossOffset >= 0 and impulseFound and heldAbove200 and retestOffset >= 0
    bool gcHasRejection = gcDetected and rejectOffset >= 0

    [c, e50, e200, rsiVal, gcDetected, gcHasRejection]

// ---- 리스크리워드 플랜 (core/risk-reward.js computeLongPlan/computeShortPlan 포팅) ----
// 진입 = 방향에 맞는 쪽에서 현재가와 가장 가까운 레벨(nearestEntry).
// 예전엔 FVG·OB·VWAP·EMA 를 단순 평균했는데 서로 무관한 레벨이 섞여 실제 지지가 아닌
// 허공 가격이 나왔고, 롱인데 진입가가 현재가보다 위인 경우가 실측 50건 중 20건이었다.
f_nearestEntry(a, b, c, d, price, isLong) =>
    float best = na
    for i = 0 to 3
        float v = i == 0 ? a : i == 1 ? b : i == 2 ? c : d
        if not na(v)
            if isLong and v <= price and (na(best) or v > best)
                best := v
            if not isLong and v >= price and (na(best) or v < best)
                best := v
    na(best) ? price : best

// 손절 버퍼 = ATR × 0.5, 단 최소 MIN_STOP_PCT % 확보 (config.riskReward)
f_stopBuffer(atrVal, price) =>
    math.max(nz(atrVal) * 0.5, price * (MIN_STOP_PCT / 100))

f_longPlan(price, fvgMid, obMid, vwap1h, ema20_15v, internalHigh, majorHigh1h, buySideTarget, swingLow, atrVal) =>
    float entry = f_nearestEntry(fvgMid, obMid, vwap1h, ema20_15v, price, true)
    float buffer = f_stopBuffer(atrVal, price)
    float rawStop = not na(swingLow) ? swingLow : price - atrVal * 2
    float stop = math.min(rawStop, entry) - buffer
    // 목표 폴백도 손익비와 기준을 맞추려 price 가 아니라 entry 기준
    float tp1 = not na(internalHigh) ? internalHigh : entry + (entry - stop) * 1.5
    float tp2 = not na(majorHigh1h) ? majorHigh1h : entry + (entry - stop) * 2.5
    float tp3 = not na(buySideTarget) ? buySideTarget : entry + (entry - stop) * 3.5
    float risk = math.max(entry - stop, 0.000000001)
    float reward = math.max(tp2 - entry, 0.0)
    float rr = reward / risk
    [entry, stop, tp1, tp2, tp3, rr]

f_shortPlan(price, fvgMid, obMid, vwap1h, ema20_15v, internalLow, majorLow1h, sellSideTarget, swingHigh, atrVal) =>
    float entry = f_nearestEntry(fvgMid, obMid, vwap1h, ema20_15v, price, false)
    float buffer = f_stopBuffer(atrVal, price)
    float rawStop = not na(swingHigh) ? swingHigh : price + atrVal * 2
    float stop = math.max(rawStop, entry) + buffer
    float tp1 = not na(internalLow) ? internalLow : entry - (stop - entry) * 1.5
    float tp2 = not na(majorLow1h) ? majorLow1h : entry - (stop - entry) * 2.5
    float tp3 = not na(sellSideTarget) ? sellSideTarget : entry - (stop - entry) * 3.5
    float risk = math.max(stop - entry, 0.000000001)
    float reward = math.max(entry - tp2, 0.0)
    float rr = reward / risk
    [entry, stop, tp1, tp2, tp3, rr]

// ============================================================================
// 조기 포착(모드 2) — core/early-detect.js 포팅. 4시간봉 고정.
// ============================================================================
// 14일 추세·24시간 변동·거래대금·박스·돌파 판정을 한 번에 반환.
f_early4h() =>
    float boxHigh = ta.highest(high, E_BOX_LOOKBACK)
    float boxLow = ta.lowest(low, E_BOX_LOOKBACK)

    // 14일 추세 강도. 부호가 아니라 크기가 신호라 절대값을 쓴다(상승·하락 양쪽 다 선행).
    float mom14 = not na(close[E_MOM_BARS]) and close[E_MOM_BARS] != 0 ?
         (close - close[E_MOM_BARS]) / close[E_MOM_BARS] * 100 : na
    float change24h = not na(close[6]) and close[6] != 0 ? (close - close[6]) / close[6] * 100 : na
    // 24시간 거래대금 근사 — 4h 6봉의 (거래량 × 종가) 합. 스캐너는 티커 quoteVolume 을 쓴다.
    float quoteVol24 = math.sum(volume * close, 6)

    float avgVol = ta.sma(volume, 20)
    float relVol = not na(avgVol) and avgVol > 0 ? volume / avgVol : na
    float relVol3 = ta.sma(relVol, 3)

    // 돌파 = 직전 봉까지의 박스 상단을 현재 종가가 넘었는가
    float prevBoxHigh = ta.highest(high, E_BOX_LOOKBACK)[1]
    bool breakoutClose = not na(prevBoxHigh) and close > prevBoxHigh
    float runFromBreak = not na(prevBoxHigh) and prevBoxHigh > 0 ? (close - prevBoxHigh) / prevBoxHigh * 100 : 0.0

    float atrVal = ta.atr(14)
    bool atrRising = not na(atrVal) and not na(atrVal[5]) and atrVal > atrVal[5]

    [close, boxHigh, boxLow, mom14, change24h, quoteVol24, relVol3,
     breakoutClose, runFromBreak, atrRising, atrVal]

// 단계 (early-detect.js classifyEarlyStage 포팅). 0 = 어디에도 안 걸림 = 후보 아님.
// 매집(압축+거래량 고갈) 게이트는 제거했다 — 표본 외 리프트가 0.64~1.72x 로 흩어졌다.
// 움직임 요인 2개(14일 추세·24시간 변동)의 히트 수로 나눈다.
f_earlyStage(mom14, change24h, breakoutClose, relVol3, atrRising, runFromBreak) =>
    int hits = (not na(mom14) and math.abs(mom14) >= E_DEAD_ZONE ? 1 : 0) +
         (not na(change24h) and math.abs(change24h) >= E_CHG_MIN ? 1 : 0)
    int st = hits >= 2 ? 2 : hits >= 1 ? 1 : 0
    if breakoutClose and not na(relVol3) and relVol3 >= E_BREAK_REL_VOL and atrRising
        st := runFromBreak <= E_BREAK_MAX_RUN ? 3 : 0
    st

// 채점 (early-detect.js scoreEarly 포팅 — 변형 D 3요인).
// 핵심 소계 하한은 없앴다. 3요인 전부 검증된 요인이라 보조 항목으로 총점을 부풀릴 구멍이
// 없고, 단독 최대인 freshness 23점은 표시 하한 40 을 못 넘는다.
f_earlyScore(mom14, change24h, ageDays, quoteVol24) =>
    float momGot = na(mom14) ? 0.0 :
         EW_MOM * math.max(0.0, math.min(1.0, (math.abs(mom14) - E_DEAD_ZONE) / (E_MOM_FULL - E_DEAD_ZONE)))
    float chgGot = na(change24h) ? 0.0 :
         EW_CHG * math.max(0.0, math.min(1.0, (math.abs(change24h) - E_CHG_MIN) / (E_CHG_FULL - E_CHG_MIN)))
    float age = na(ageDays) ? E_AGE_UNKNOWN : ageDays
    float freshGot = EW_FRESH * (1 - math.max(0.0, math.min(1.0, (age - E_FRESH_FULL) / (E_FRESH_ZERO - E_FRESH_FULL))))
    float s = momGot + chgGot + freshGot
    s += na(quoteVol24) or quoteVol24 < E_MIN_QUOTE_VOL ? EP_THIN : 0.0
    math.max(0.0, math.min(100.0, math.round(s)))

// 등급 (config.earlyGrades — 검증셋 리프트 계단 8.25x / 4.57x / 3.35x / 2.03x 에 맞춘 경계)
f_earlyGrade(score) =>
    score >= 70 ? "강한 후보" : score >= 55 ? "관심 후보" : score >= 40 ? "관찰 후보" : score >= 25 ? "조건 부족" : "제외"

// ============================================================================
// 멀티타임프레임 데이터 요청 — QARScanner 와 동일하게 차트 시간봉과 무관하게 고정
// ============================================================================
[c1, atr1, avgVol1, relVol1, rsi1, ema20_1, vwap1, bullShift1, choch1, firstHH1, firstHL1,
 lowSweepEx1, lowSweepValid1, lowSweepRec1, highSweepEx1, highSweepValid1, highSweepRec1,
 nearHighAbove1, nearLowBelow1, eqHighNear1, eqLowNear1,
 change6h, nearLowPct1, nearHighPct1, volTrend1, recentLow1, recentHigh1, lastLabel1, bearShift1] =
     request.security(syminfo.tickerid, "60", f_coreTF(), barmerge.gaps_off, barmerge.lookahead_off)

[c15, atr15, avgVol15, relVol15, rsi15, ema20_15, vwap15, bullShift15, choch15, firstHH15, firstHL15,
 lowSweepEx15, lowSweepValid15, lowSweepRec15, highSweepEx15, highSweepValid15, highSweepRec15,
 nearHighAbove15, nearLowBelow15, eqHighNear15, eqLowNear15,
 change6h15, nearLowPct15, nearHighPct15, volTrend15, recentLow15, recentHigh15, lastLabel15, bearShift15] =
     request.security(syminfo.tickerid, "15", f_coreTF(), barmerge.gaps_off, barmerge.lookahead_off)

[fvgBullLow, fvgBullHigh, fvgBearLow, fvgBearHigh, obBullLow, obBullHigh, obBearLow, obBearHigh,
 cvdSlope15, delta15, upperWick15, lowerWick15, closePos15, sellRatio15, highVol15, chopIndex15] =
     request.security(syminfo.tickerid, "15", f_extra15(), barmerge.gaps_off, barmerge.lookahead_off)

[c5, atr5, avgVol5, relVol5, rsi5, ema20_5, vwap5, bullShift5, choch5, firstHH5, firstHL5,
 lowSweepEx5, lowSweepValid5, lowSweepRec5, highSweepEx5, highSweepValid5, highSweepRec5,
 nearHighAbove5, nearLowBelow5, eqHighNear5, eqLowNear5,
 change6h5, nearLowPct5, nearHighPct5, volTrend5, recentLow5, recentHigh5, lastLabel5, bearShift5] =
     request.security(syminfo.tickerid, "5", f_coreTF(), barmerge.gaps_off, barmerge.lookahead_off)

[c4, ema50_4, ema200_4, rsi4, gcDetected, gcHasRejection] =
     request.security(syminfo.tickerid, "240", f_trend4h(), barmerge.gaps_off, barmerge.lookahead_off)

// ---- 모드 2 (조기 포착) 데이터 ----
[ePrice, eBoxHigh, eBoxLow, eMom14, eChange24h, eQuoteVol24, eRelVol3,
 eBreakout, eRunFromBreak, eAtrRising, eAtr4] =
     request.security(syminfo.tickerid, "240", f_early4h(), barmerge.gaps_off, barmerge.lookahead_off)

// 상장 경과일 — 일봉 개수로 센다(암호화폐는 휴장이 없어 봉 수 ≈ 경과일).
// 차트 이력이 잘리면 실제보다 짧게 나와 freshness 가 과대평가된다. 800일이 만점 소멸
// 지점이라 그 이상 이력만 있으면 결과는 같다.
eAgeDays = request.security(syminfo.tickerid, "1D", ta.cum(1), barmerge.gaps_off, barmerge.lookahead_off)

price = c15

// ============================================================================
// 방향별 시그널 조립 (scanner/deep-scanner.js buildLongSignals/buildShortSignals 포팅)
// ============================================================================
bool is4hStrongDown = not na(ema50_4) and not na(ema200_4) and c4 < ema50_4 and ema50_4 < ema200_4 and rsi4 < 42
bool is4hStrongUp = not na(ema50_4) and not na(ema200_4) and c4 > ema50_4 and ema50_4 > ema200_4 and rsi4 > 58

// QARScanner 자체 유동성 게이트(24h 거래대금)를 이미 통과한 종목이라는 전제(코인신호기에서 클릭해 들어온 심볼) — 재계산 생략
bool goodLiquidity = true

// ---- 롱 ----
bool fvgObOverlapL = not na(fvgBullLow) and not na(obBullLow) and math.max(fvgBullLow, obBullLow) <= math.min(fvgBullHigh, obBullHigh)
bool structureShift1hL = bullShift1
bool volumeDeltaShiftL = cvdSlope15 > 0 and volTrend15 >= 1.0
bool cvdImprovedL = cvdSlope15 > 0
bool deltaImprovedL = delta15 > 0
bool low5mDefendedL = lowSweepRec5
bool entryTrigger5mL = choch5 or (firstHL5 and volTrend5 >= 1.1)
bool volumeReSurgeL = volTrend5 >= 1.2 or volTrend15 >= 1.6
bool volumeReactedL = volTrend15 >= 1.0
bool dropAndOversoldL = (change6h <= -1.5 or nearLowPct1 <= 18) and rsi1 <= 50  // config.candidateFilter 완화값과 동기화(-3/12 → -1.5/18)
bool lowSweepL = lowSweepEx15 or lowSweepEx1
bool sweepRecoveredL = lowSweepRec15 or lowSweepRec1
bool firstPushDoneL = lastLabel15 == "HH" and nearLowPct15 > 8
bool fvgCreatedL = not na(fvgBullLow)
bool obCreatedL = not na(obBullLow)

bool change15mOverExtL = nearLowPct15 > 12 and rsi15 > 70
bool farFromLowAtrL = atr15 > 0 and (price - recentLow15) / atr15 > 8
bool strongResistanceAboveL = eqHighNear1
bool tooLowVolumeL = volTrend15 < 0.5
bool strongDowntrend4hL = is4hStrongDown
bool rsiOverheatedL = rsi15 > 78 or rsi5 > 82

fvgBullMid = not na(fvgBullLow) ? (fvgBullLow + fvgBullHigh) / 2 : na
obBullMid = not na(obBullLow) ? (obBullLow + obBullHigh) / 2 : na
[entryL, stopL, tp1L, tp2L, tp3L, rrL] = f_longPlan(price, fvgBullMid, obBullMid,
     vwap1, ema20_15, nearHighAbove15, nearHighAbove1, nearHighAbove1, recentLow15, atr15)
bool riskRewardOkL = rrL >= 2
bool poorRiskRewardL = rrL < 1.5
bool shortTargetDistanceL = not na(nearHighAbove1) and atr15 > 0 and (nearHighAbove1 - price) / atr15 < 1.5

bool cvdCondL = cvdSlope15 < 0 and change6h >= -1
int absPtsL = 0
absPtsL += sellRatio15 > 0.5 ? 1 : 0
absPtsL += highVol15 ? 1 : 0
absPtsL += closePos15 >= 0.5 ? 1 : 0
absPtsL += lowerWick15 >= 0.3 ? 1 : 0
absPtsL += sweepRecoveredL ? 1 : 0
absPtsL += cvdCondL ? 1 : 0
string absLevelL = absPtsL >= 5 ? "strong" : absPtsL >= 3 ? "normal" : "insufficient"

// ---- 숏(대칭) ----
bool fvgObOverlapS = not na(fvgBearLow) and not na(obBearLow) and math.max(fvgBearLow, obBearLow) <= math.min(fvgBearHigh, obBearHigh)
bool structureShift1hS = bearShift1 // 1h 마지막 이벤트가 하락 방향(=bearShift)
bool volumeDeltaShiftS = cvdSlope15 < 0 and volTrend15 >= 1.0
bool cvdImprovedS = cvdSlope15 < 0
bool deltaImprovedS = delta15 < 0
bool high5mDefendedS = highSweepRec5
bool entryTrigger5mS = choch5 or (not firstHL5 and volTrend5 >= 1.1)
bool volumeReSurgeS = volTrend5 >= 1.2 or volTrend15 >= 1.6
bool volumeReactedS = volTrend15 >= 1.0
bool dropAndOversoldS = (change6h >= 1.5 or nearHighPct1 <= 18) and rsi1 >= 50  // config.candidateFilter 완화값과 동기화(3/12 → 1.5/18)
bool highSweepS = highSweepEx15 or highSweepEx1
bool sweepRecoveredS = highSweepRec15 or highSweepRec1
bool firstPushDoneS = lastLabel15 == "LL" and nearHighPct15 > 8
bool fvgCreatedS = not na(fvgBearLow)
bool obCreatedS = not na(obBearLow)

bool change15mOverExtS = nearHighPct15 > 12 and rsi15 < 30
bool farFromLowAtrS = atr15 > 0 and (recentHigh15 - price) / atr15 > 8
bool strongResistanceAboveS = eqLowNear1
bool tooLowVolumeS = volTrend15 < 0.5
bool strongDowntrend4hS = is4hStrongUp
bool rsiOverheatedS = rsi15 < 22 or rsi5 < 18

fvgBearMid = not na(fvgBearLow) ? (fvgBearLow + fvgBearHigh) / 2 : na
obBearMid = not na(obBearLow) ? (obBearLow + obBearHigh) / 2 : na
[entryS, stopS, tp1S, tp2S, tp3S, rrS] = f_shortPlan(price, fvgBearMid, obBearMid,
     vwap1, ema20_15, nearLowBelow15, nearLowBelow1, nearLowBelow1, recentHigh15, atr15)
bool riskRewardOkS = rrS >= 2
bool poorRiskRewardS = rrS < 1.5
bool shortTargetDistanceS = not na(nearLowBelow1) and atr15 > 0 and (price - nearLowBelow1) / atr15 < 1.5

bool cvdCondS = cvdSlope15 > 0 and change6h <= 1
int absPtsS = 0
absPtsS += (1 - sellRatio15) > 0.5 ? 1 : 0
absPtsS += highVol15 ? 1 : 0
absPtsS += closePos15 <= 0.5 ? 1 : 0
absPtsS += upperWick15 >= 0.3 ? 1 : 0
absPtsS += sweepRecoveredS ? 1 : 0
absPtsS += cvdCondS ? 1 : 0
string absLevelS = absPtsS >= 5 ? "strong" : absPtsS >= 3 ? "normal" : "insufficient"

// ============================================================================
// 점수 (core/scoring.js scoreCandidate 포팅, 가중치 고정 + 강도별 감점/최소점수 적용)
// ============================================================================
f_score(dropOk, sweepValid, recovered, absLevel, structOk, fvgObOk, deltaOk, entry5mOk, rrOk,
     overExt, farLow, resAbove, tgtDist, lowVol, down4h, poorRR) =>
    float s = 0.0
    s += dropOk ? wDrop : 0
    s += goodLiquidity ? wVol : 0
    s += sweepValid ? wSweep : 0
    s += recovered ? wRecover : 0
    s += absLevel != "insufficient" ? wAbsorb : 0
    s += structOk ? wStruct : 0
    s += fvgObOk ? wFvgOb : 0
    s += deltaOk ? wDelta : 0
    s += entry5mOk ? wEntry5m : 0
    s += rrOk ? wRR : 0
    s += overExt ? pOverExt : 0
    s += farLow ? pFarLow : 0
    s += lowVol ? pLowVol : 0
    s += down4h ? pDown4h : 0
    s += false ? pNewList : 0  // 라이브 차트엔 "신규 상장" 개념 없음 — 항상 미해당
    // 감점 그룹 (config.penaltyGroups.upsideSpace) — 바로 위 저항·목표까지 거리·손익비는
    // 모두 "위로 갈 공간이 없다" 는 한 사실이다. 겹쳐 차감하면 핵심 만점 종목이 -26 을
    // 맞는다(실측). 그룹에서 가장 센 감점 하나만 적용한다.
    float upside = 0.0
    upside := math.min(upside, resAbove ? pResAbove : 0.0)
    upside := math.min(upside, tgtDist ? pTgtDist : 0.0)
    upside := math.min(upside, poorRR ? pPoorRR : 0.0)
    s += upside
    math.max(0.0, math.min(100.0, math.round(s)))

scoreL = f_score(dropAndOversoldL, lowSweepValid15, sweepRecoveredL, absLevelL, structureShift1hL, fvgObOverlapL,
     volumeDeltaShiftL, entryTrigger5mL, riskRewardOkL,
     change15mOverExtL, farFromLowAtrL, strongResistanceAboveL, shortTargetDistanceL, tooLowVolumeL, strongDowntrend4hL, poorRiskRewardL)
scoreS = f_score(dropAndOversoldS, highSweepValid15, sweepRecoveredS, absLevelS, structureShift1hS, fvgObOverlapS,
     volumeDeltaShiftS, entryTrigger5mS, riskRewardOkS,
     change15mOverExtS, farFromLowAtrS, strongResistanceAboveS, shortTargetDistanceS, tooLowVolumeS, strongDowntrend4hS, poorRiskRewardS)

// ---- 단계 (core/scoring.js classifyStage 포팅, 우선순위 5→4→3→2→1) ----
f_stage(chase, entry4, struct3, liq2) =>
    chase ? 5 : entry4 ? 4 : struct3 ? 3 : liq2 ? 2 : 1

// poorRiskReward 는 5단계 판정에서 뺐다. "늦었다" 는 시장 국면인데 손익비는 계획 품질이라
// 개념이 다르고, RR<1.5 만으로 실측 50건 중 33건이 추격 금지로 몰렸다. 감점으로만 반영한다.
stage5L = change15mOverExtL or farFromLowAtrL or shortTargetDistanceL or rsiOverheatedL
stage4L = (not na(fvgBullLow) or not na(obBullLow)) and (choch5 or low5mDefendedL) and volumeReSurgeL
stage3L = (choch1 or choch15) and (firstHH1 or firstHH15 or firstHL1 or firstHL15) and (fvgCreatedL or obCreatedL) and not firstPushDoneL
stage2L = lowSweepL and sweepRecoveredL and volumeReactedL and (cvdImprovedL or deltaImprovedL)
stageL = f_stage(stage5L, stage4L, stage3L, stage2L)

stage5S = change15mOverExtS or farFromLowAtrS or shortTargetDistanceS or rsiOverheatedS
stage4S = (not na(fvgBearLow) or not na(obBearLow)) and (choch5 or high5mDefendedS) and volumeReSurgeS
stage3S = (choch1 or choch15) and (firstHH1 or firstHH15 or firstHL1 or firstHL15) and (fvgCreatedS or obCreatedS) and not firstPushDoneS
stage2S = highSweepS and sweepRecoveredS and volumeReactedS and (cvdImprovedS or deltaImprovedS)
stageS = f_stage(stage5S, stage4S, stage3S, stage2S)

// ---- 핵심 신호 소계 (config.reversalCoreKeys / reversalCoreMinPct) ----
// 스윕·스윕회수·1h구조전환·FVG/OB 합 50점. 실측에서 점수는 "급락 및 과매도"·"거래대금"
// 같은 쉬운 보조 항목이 만들고 있었고 저점 스윕은 50건 중 2건만 적중했다.
f_corePctRev(sweepValid, recovered, structOk, fvgObOk) =>
    float got = (sweepValid ? wSweep : 0.0) + (recovered ? wRecover : 0.0) +
         (structOk ? wStruct : 0.0) + (fvgObOk ? wFvgOb : 0.0)
    got / (wSweep + wRecover + wStruct + wFvgOb) * 100

corePctL = f_corePctRev(lowSweepValid15, sweepRecoveredL, structureShift1hL, fvgObOverlapL)
corePctS = f_corePctRev(highSweepValid15, sweepRecoveredS, structureShift1hS, fvgObOverlapS)

// ---- 방향 결정 (모드 1) ----
bool forceLong = dirInput == "롱만"
bool forceShort = dirInput == "숏만"
bool useLong = forceLong or (not forceShort and scoreL >= scoreS)
revScore = useLong ? scoreL : scoreS
revStage = useLong ? stageL : stageS
revDir = useLong ? "LONG" : "SHORT"
revEntry = useLong ? entryL : entryS
revStop = useLong ? stopL : stopS
revTp1 = useLong ? tp1L : tp1S
revTp2 = useLong ? tp2L : tp2S
revRR = useLong ? rrL : rrS
revCorePct = useLong ? corePctL : corePctS

// 등급 경계 (config.grades) — 실측 최고점이 60 이라 예전 85/75/65/55 는 50건 중 48건이
// "제외" 로 표시됐다.
f_grade(score) =>
    score >= 55 ? "강한 후보" : score >= 40 ? "관심 후보" : score >= 30 ? "관찰 후보" : score >= 20 ? "조건 부족" : "제외"

// ============================================================================
// 모드 2 (조기 포착) 조립 — early-detect.js buildEarlyResult 순서 그대로
// ============================================================================
// 제외 사유 (earlyExclusion). 펀딩비는 TradingView 에서 못 읽지만, 재적합에서 펀딩이
// 채점·제외 양쪽에서 빠졌으므로 이제 스캐너와 조건이 완전히 같다.
bool eExcluded = not na(eChange24h) and eChange24h > E_PUMPED_MAX
eStage = f_earlyStage(eMom14, eChange24h, eBreakout, eRelVol3, eAtrRising, eRunFromBreak)
eScoreRaw = f_earlyScore(eMom14, eChange24h, eAgeDays, eQuoteVol24)
// 단계에 안 걸리거나 제외면 후보가 아니다 → 점수 0 으로 눌러 진입 조건에서 자동 탈락
eScore = (eExcluded or eStage == 0) ? 0.0 : eScoreRaw
eGrade = f_earlyGrade(eScore)

// 진입 계획 (earlyPlan) — R 배수 기반. 박스 하단을 손절로 쓰면 폭락 후 반등 후보에서
// 박스 폭이 수백 % 라 손익비 1:24 가 찍힌다(스캐너에서 실측). ATR 배수로 상한을 건다.
eSpan = math.max(eBoxHigh - eBoxLow, 0.000000001)
eEntry = ePrice
eStop = nz(eAtr4) > 0 ? eEntry - eAtr4 * E_STOP_ATR : math.min(eBoxLow, eEntry) - eEntry * 0.001
eRisk = math.max(eEntry - eStop, 0.000000001)
eTp1 = eEntry + eRisk * E_PARTIAL_R
eTp2 = eEntry + eRisk * E_TARGET_R
eRR = (eTp2 - eEntry) / eRisk

// ---- 모드 선택 ----
bool mode1On = modeInput != "2 조기 포착"
bool mode2On = modeInput != "1 급락 반등"
// 각 모드의 자체 문턱: 모드 1 = 강도 기준, 모드 2 = config.earlyMinScore(40) 고정.
// early 는 점수대가 달라 reversal 의 minScore·강도를 그대로 쓸 수 없다.
// 모드 2 는 핵심 소계 하한이 없다(3요인 전부 검증 요인) — useCoreGate 는 모드 1 전용.
bool rev1Ready = mode1On and revScore >= minScoreThresh and (not useCoreGate or revCorePct >= CORE_MIN_PCT)
bool early2Ready = mode2On and eScore >= E_MIN_SCORE

// 표시용 대표값 — 모드 1 우선(둘 다 조건 충족이면 구조 확인된 쪽을 먼저 잡는다).
// 모드 2 만 켠 경우엔 조건 미달이어도 모드 2 값을 보여준다(모드 1 숫자가 뜨면 오해한다).
bool useEarly = not mode1On or (early2Ready and not rev1Ready)
activeMode = useEarly ? 2 : 1
finalScore = useEarly ? eScore : revScore
finalStage = useEarly ? eStage : revStage
finalDir = useEarly ? "LONG" : revDir      // early 는 롱 전용
finalEntry = useEarly ? eEntry : revEntry
finalStop = useEarly ? eStop : revStop
finalTp1 = useEarly ? eTp1 : revTp1
finalTp2 = useEarly ? eTp2 : revTp2
finalRR = useEarly ? eRR : revRR
finalGrade = useEarly ? eGrade : f_grade(revScore)
passesStrictness = useEarly ? early2Ready : rev1Ready

// ============================================================================
// 트레이드 상태 기계 — 진입 시점에 화살표, 목표2/손절 도달 전까지 라인 유지
// (마감 확정봉 기준. 진입봉 자체는 청산 판정에서 제외 — QARScanner 리스크리워드와 동일 철학)
// ============================================================================
// 모드별 색 — 모드 1 은 방향색(초록/빨강), 모드 2 는 주황 계열로 통일해 한눈에 구분된다.
C_MODE2 = color.rgb(245, 158, 11)
bool dirLong = useEarly or useLong
plotColor = useEarly ? C_MODE2 : useLong ? color.rgb(18, 153, 91) : color.rgb(216, 58, 58)

var bool inTrade = false
var int tDir = 0            // 1=롱, -1=숏
var int tMode = 0           // 1=급락 반등, 2=조기 포착 (청산 표시·라벨 구분용)
var float tEntry = na
var float tStop = na
var float tTp1 = na
var float tTp2 = na
var int tResult = 0         // 0=진행/없음, 1=목표 도달, -1=손절
var int lastStopBar = na    // 마지막 손절 봉 (쿨다운 계산용)
var int lastEntryBar = na   // 마지막 진입 봉 (진입 간격 계산용)

// ---- 진입 품질 필터 ----
bool trendOk = not useTrendFilter or (dirLong ? (not na(ema200_4) and c4 > ema200_4) : (not na(ema200_4) and c4 < ema200_4))
// 단계 필터는 모드 1 전용. 모드 2 의 단계는 1 관찰·2 임박·3 돌파로 의미가 달라
// reversal 의 "3=구조전환 확인 후" 문턱을 그대로 대면 관찰·임박 구간이 전부 잘린다.
bool stageOk = useEarly ? finalStage >= 1 : (finalStage >= minStageInput and finalStage != 5)
bool rrGateOk = finalRR >= minRRInput
bool cooldownOk = na(lastStopBar) or (bar_index - lastStopBar) > cooldownBars
// 진입 간격: 마지막 진입 이후 minEntryGap 봉 지나야 다음 진입 허용 (표시 간격 조절)
bool gapOk = minEntryGap <= 0 or na(lastEntryBar) or (bar_index - lastEntryBar) >= minEntryGap
// 노이즈 필터 (스캐너 core/noise-filter.js 와 동일): 촙 구간·저거래량이면 진입 제외.
// 모드 2 는 적용하지 않는다 — 스캐너 ui/settings.applyFilters 도 early 모드에선
// 이 필터를 건너뛴다. 켜고 끄는 기준을 한쪽만 바꾸면 두 화면의 후보가 갈라진다.
bool noisy = not useEarly and useNoiseFilter and ((not na(chopIndex15) and chopIndex15 > noiseChopMax) or (not na(volTrend15) and volTrend15 < noiseMinRelVol))
bool noiseOk = not noisy

// 진입 조건: 표시 켬 + 마감 확정봉 + 점수 통과 + 품질필터 통과 + 간격 통과 + 노이즈 아님 + 미보유
bool canEnter = showPlan and barstate.isconfirmed and passesStrictness and stageOk and trendOk and rrGateOk and cooldownOk and gapOk and noiseOk and not inTrade
bool justEntered = canEnter
if canEnter
    lastEntryBar := bar_index
bool longEntry = canEnter and not useEarly and useLong
bool shortEntry = canEnter and not useEarly and not useLong
bool earlyEntry = canEnter and useEarly

if canEnter
    inTrade := true
    tDir := dirLong ? 1 : -1
    tMode := activeMode
    tEntry := finalEntry
    tStop := finalStop
    tTp1 := finalTp1
    tTp2 := finalTp2
    tResult := 0

// 청산 판정: 보유 중 + 진입봉 아님 + 확정봉에서 손절/목표2 도달
if inTrade and not justEntered and barstate.isconfirmed
    if tDir == 1
        if low <= tStop
            inTrade := false
            tResult := -1
            lastStopBar := bar_index
        else if high >= tTp2
            inTrade := false
            tResult := 1
    else
        if high >= tStop
            inTrade := false
            tResult := -1
            lastStopBar := bar_index
        else if low <= tTp2
            inTrade := false
            tResult := 1

bool exitEvent = not inTrade and inTrade[1]

// 진입 화살표 — 모드 1 은 삼각형(방향색), 모드 2 는 다이아몬드(주황). 모양으로 모드가 구분된다.
plotshape(longEntry, "① 롱 진입", style = shape.triangleup, location = location.belowbar, color = color.rgb(18, 153, 91), size = size.small, text = "①롱")
plotshape(shortEntry, "① 숏 진입", style = shape.triangledown, location = location.abovebar, color = color.rgb(216, 58, 58), size = size.small, text = "①숏")
plotshape(earlyEntry, "② 조기 포착 진입", style = shape.diamond, location = location.belowbar, color = C_MODE2, size = size.small, text = "②조기")

// 청산 표시
plotshape(exitEvent and tResult == 1, "익절", style = shape.xcross, location = location.abovebar, color = color.rgb(34, 197, 94), size = size.tiny, text = "익절")
plotshape(exitEvent and tResult == -1, "손절 청산", style = shape.xcross, location = location.belowbar, color = color.rgb(255, 77, 109), size = size.tiny, text = "손절")

// 보유 중에만 라인 유지 (linebr 로 청산 시 끊김) — 값 고정이라 수평선.
// 진입가 선 색으로도 어느 모드의 트레이드인지 보인다.
entryLineCol = tMode == 2 ? C_MODE2 : color.rgb(124, 92, 252)
plot(inTrade ? tEntry : na, "진입가", color = entryLineCol, style = plot.style_linebr, linewidth = 2)
plot(inTrade ? tStop : na, "손절선", color = color.rgb(255, 77, 109), style = plot.style_linebr, linewidth = 2)
plot(inTrade ? tTp1 : na, "목표1", color = color.rgb(34, 211, 238), style = plot.style_linebr, linewidth = 1)
plot(inTrade ? tTp2 : na, "목표2", color = color.rgb(34, 197, 94), style = plot.style_linebr, linewidth = 1)

// ============================================================================
// 진입 구간 박스 — 두 모드를 서로 다른 색·선으로 표시
//   모드 1: 15분봉 FVG·오더블록 구간 (보라 실선). 되돌림을 기다리는 지지/저항 구간.
//   모드 2: 4시간봉 박스 (주황 점선) + 박스 상단 돌파 밴드 (주황 실선).
// ============================================================================
C_MODE1 = color.rgb(124, 92, 252)

// 모드 1 구간 = 방향에 맞는 FVG·OB. 둘이 겹치면 교집합(= 스캐너의 fvgObOverlap), 아니면 FVG.
f_zone1(isLong, fbL, fbH, obL, obH, fsL, fsH, osL, osH) =>
    float fLow = isLong ? fbL : fsL
    float fHigh = isLong ? fbH : fsH
    float oLow = isLong ? obL : osL
    float oHigh = isLong ? obH : osH
    float zl = na
    float zh = na
    if not na(fLow) and not na(oLow)
        zl := math.max(fLow, oLow)
        zh := math.min(fHigh, oHigh)
        if zl > zh
            zl := fLow
            zh := fHigh
    else if not na(fLow)
        zl := fLow
        zh := fHigh
    else if not na(oLow)
        zl := oLow
        zh := oHigh
    [zl, zh]

[z1Low, z1High] = f_zone1(useLong, fvgBullLow, fvgBullHigh, obBullLow, obBullHigh,
     fvgBearLow, fvgBearHigh, obBearLow, obBearHigh)

var box zone1 = na
var box zone2 = na
var box zone2b = na
var label zone1Lbl = na
var label zone2Lbl = na

if barstate.islast
    box.delete(zone1)
    box.delete(zone2)
    box.delete(zone2b)
    label.delete(zone1Lbl)
    label.delete(zone2Lbl)
    int rightX = bar_index + 12
    // 차트 초반엔 bar_index 가 작아 왼쪽 좌표가 음수가 되면 런타임 오류가 난다
    int left1 = math.max(bar_index - 40, 0)
    int left2 = math.max(bar_index - 150, 0)
    if showZones and mode1On and not na(z1Low)
        zone1 := box.new(left1, z1High, rightX, z1Low,
             border_color = C_MODE1, border_width = 2, border_style = line.style_solid,
             bgcolor = color.new(C_MODE1, 88))
        zone1Lbl := label.new(rightX, z1High, "① 급락 반등 진입 구간 (15m FVG·OB)",
             style = label.style_label_left, color = color.new(C_MODE1, 20),
             textcolor = color.white, size = size.small)
    if showZones and mode2On and not na(eBoxHigh) and not na(eBoxLow)
        // 최근 60봉(4h) 고저 박스 — 점선. 채점에는 안 쓰고 위치 파악용으로만 그린다.
        zone2 := box.new(left2, eBoxHigh, rightX, eBoxLow,
             border_color = C_MODE2, border_width = 1, border_style = line.style_dashed,
             bgcolor = color.new(C_MODE2, 94))
        // 돌파 밴드 — 박스 상단에서 박스 폭 10% 까지. 여기를 종가로 넘으면 3단계 돌파.
        zone2b := box.new(left2, eBoxHigh + eSpan * 0.1, rightX, eBoxHigh,
             border_color = C_MODE2, border_width = 2, border_style = line.style_solid,
             bgcolor = color.new(C_MODE2, 80))
        zone2Lbl := label.new(rightX, eBoxLow, "② 조기 포착 박스 (4h·60봉) · 상단 = 돌파 진입",
             style = label.style_label_left, color = color.new(C_MODE2, 20),
             textcolor = color.white, size = size.small)

f_tablePos(s) =>
    s == "왼쪽 위" ? position.top_left : s == "왼쪽 가운데" ? position.middle_left : s == "왼쪽 아래" ? position.bottom_left : s == "오른쪽 위" ? position.top_right : s == "오른쪽 가운데" ? position.middle_right : s == "오른쪽 아래" ? position.bottom_right : s == "가운데 위" ? position.top_center : position.bottom_center
f_tableSize(s) =>
    s == "아주 작게" ? size.tiny : s == "작게" ? size.small : s == "크게" ? size.large : size.normal
dashSz = f_tableSize(tableSizeInput)
// 단계 라벨 — 두 모드의 단계는 뜻이 다르다(모드 2 는 매집·임박·돌파 3단계뿐).
f_stageLabel(md, st) =>
    md == 2 ? (st == 3 ? "3 돌파" : st == 2 ? "2 임박" : st == 1 ? "1 관찰" : "해당 없음") :
     st == 5 ? "5 추격 금지" : st == 4 ? "4 진입 구간" : st == 3 ? "3 구조전환" : st == 2 ? "2 유동성 회수" : "1 관찰 초기"

var table t = table.new(f_tablePos(tablePosInput), 2, 12, bgcolor = color.new(color.rgb(14, 19, 29), 10), border_width = 1)
if showTable and barstate.islast
    table.cell(t, 0, 0, "모드", text_color = color.white, bgcolor = color.rgb(30, 34, 45), text_size = dashSz)
    table.cell(t, 1, 0, activeMode == 2 ? "② 조기 포착" : "① 급락 반등", text_color = activeMode == 2 ? C_MODE2 : C_MODE1, bgcolor = color.rgb(30, 34, 45), text_size = dashSz)
    table.cell(t, 0, 1, "방향", text_color = color.white, text_size = dashSz)
    table.cell(t, 1, 1, finalDir, text_color = plotColor, text_size = dashSz)
    table.cell(t, 0, 2, "점수", text_color = color.white, text_size = dashSz)
    table.cell(t, 1, 2, str.tostring(finalScore) + " (" + finalGrade + ")", text_color = passesStrictness ? color.rgb(18, 153, 91) : color.rgb(150, 150, 150), text_size = dashSz)
    table.cell(t, 0, 3, "단계", text_color = color.white, text_size = dashSz)
    table.cell(t, 1, 3, f_stageLabel(activeMode, finalStage), text_color = color.white, text_size = dashSz)
    table.cell(t, 0, 4, "핵심 소계", text_color = color.white, text_size = dashSz)
    table.cell(t, 1, 4, activeMode == 2 ? "미적용 (3요인 채점)" :
         str.tostring(revCorePct, "#.#") + "% / " + str.tostring(CORE_MIN_PCT, "#") + "%" + (useCoreGate ? "" : " (미적용)"),
         text_color = activeMode == 2 or not useCoreGate ? color.gray : revCorePct >= CORE_MIN_PCT ? color.rgb(18, 153, 91) : color.rgb(255, 179, 71), text_size = dashSz)
    table.cell(t, 0, 5, "진입 문턱", text_color = color.white, text_size = dashSz)
    table.cell(t, 1, 5, activeMode == 2 ? "최소 " + str.tostring(E_MIN_SCORE, "#") + "점 (early 고정)" :
         "최소 " + str.tostring(minScoreThresh) + "점" + (entryScoreMin > 0 ? " (직접)" : " (강도 " + str.tostring(strictLevel) + ")") + (minEntryGap > 0 ? " · 간격 " + str.tostring(minEntryGap) + "봉" : ""),
         text_color = color.white, text_size = dashSz)
    table.cell(t, 0, 6, inTrade ? "진입(보유중)" : "진입", text_color = color.white, text_size = dashSz)
    table.cell(t, 1, 6, str.tostring(inTrade ? tEntry : finalEntry, "#.########"), text_color = inTrade ? entryLineCol : color.white, text_size = dashSz)
    table.cell(t, 0, 7, "손절", text_color = color.white, text_size = dashSz)
    table.cell(t, 1, 7, str.tostring(inTrade ? tStop : finalStop, "#.########"), text_color = color.rgb(255, 77, 109), text_size = dashSz)
    table.cell(t, 0, 8, "손익비", text_color = color.white, text_size = dashSz)
    table.cell(t, 1, 8, "1:" + str.tostring(finalRR, "#.##"), text_color = color.white, text_size = dashSz)
    table.cell(t, 0, 9, "골든크로스 리테스트(4h)", text_color = color.white, text_size = dashSz)
    table.cell(t, 1, 9, gcDetected ? (gcHasRejection ? "확정" : "대기") : "-", text_color = gcHasRejection ? color.rgb(111, 224, 242) : color.gray, text_size = dashSz)
    table.cell(t, 0, 10, "② 14일 · 24h · 상장", text_color = color.white, text_size = dashSz)
    table.cell(t, 1, 10, (na(eMom14) ? "-" : str.tostring(eMom14, "#.#") + "%") + " · " +
         (na(eChange24h) ? "-" : str.tostring(eChange24h, "#.#") + "%") + " · " +
         (na(eAgeDays) ? "-" : str.tostring(eAgeDays, "#") + "일"),
         text_color = na(eMom14) ? color.rgb(255, 179, 71) : color.white, text_size = dashSz)
    table.cell(t, 0, 11, "비고", text_color = color.white, text_size = dashSz)
    bool tfOk = timeframe.period == "15"
    table.cell(t, 1, 11, tfOk ? "taker 데이터 근사(정밀도 제한)" : "⚠ 15분 차트 권장 (현재 " + timeframe.period + ")",
         text_color = tfOk ? color.gray : color.rgb(255, 179, 71), text_size = dashSz)
