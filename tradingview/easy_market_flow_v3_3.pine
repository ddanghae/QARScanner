             text = showDetailVisuals and showZoneText ? "반응 후보  ▲  · 기준봉 거래량 " + str.tostring(_volRatio, "#.0") + "×" : "",
             text_color = color.new(bullColor, showDetailVisuals ? zoneTextTransparency : 100),
             text_size = f_textSize(zoneTextSizeInput))
        array.push(bullObBoxes, _b)
        array.push(bullObCreatedBars, bar_index)
        if array.size(bullObBoxes) > maxObZones
            box.delete(array.shift(bullObBoxes))
            array.shift(bullObCreatedBars)

if barClosed and showOB and bearObTrigger
    [_top, _bottom, _offset, _volRatio] = f_lastBullishCandle(obLookback)
    if not na(_offset)
        float _obOpaque = math.min(obMinTransparency, obBaseTransparency)
