// ─────────────────────────────────────────────────────────────────────────────
// PREMIUM / DISCOUNT
// ─────────────────────────────────────────────────────────────────────────────
bool pdValid = not na(lastSwingHigh) and not na(lastSwingLow) and lastSwingHigh > lastSwingLow
float rangeHigh = pdValid ? lastSwingHigh : na
float rangeLow = pdValid ? lastSwingLow : na
float rangeSize = pdValid ? lastSwingHigh - lastSwingLow : na
float discountCeiling = pdValid ? lastSwingLow + rangeSize * pdDepthPct / 100.0 : na
float premiumFloor = pdValid ? lastSwingHigh - rangeSize * pdDepthPct / 100.0 : na

rangePlotLineStyle = rangeLineStyleInput == "점선" ? plot.linestyle_dashed : rangeLineStyleInput == "도트" ? plot.linestyle_dotted : plot.linestyle_solid
pRangeHigh = plot(showPD ? rangeHigh : na, "최근 큰 범위 위쪽", color = color.new(bearColor, math.min(100, rangeLineTransparency + 44)), style = plot.style_linebr, linewidth = rangeLineWidth, linestyle = rangePlotLineStyle)
pPremiumFloor = plot(showPD ? premiumFloor : na, "하락 후보 범위 시작", color = color.new(accentColor, rangeLineTransparency), style = plot.style_linebr, linewidth = rangeLineWidth, linestyle = rangePlotLineStyle)
pDiscountCeiling = plot(showPD ? discountCeiling : na, "상승 후보 범위 끝", color = color.new(accentColor, rangeLineTransparency), style = plot.style_linebr, linewidth = rangeLineWidth, linestyle = rangePlotLineStyle)
pRangeLow = plot(showPD ? rangeLow : na, "최근 큰 범위 아래쪽", color = color.new(bullColor, math.min(100, rangeLineTransparency + 44)), style = plot.style_linebr, linewidth = rangeLineWidth, linestyle = rangePlotLineStyle)

fill(pRangeHigh, pPremiumFloor, color = showPD ? color.new(bearColor, rangeFillTransparency) : na, title = "범위 위쪽")
fill(pDiscountCeiling, pRangeLow, color = showPD ? color.new(bullColor, rangeFillTransparency) : na, title = "범위 아래쪽")

plot(showSwingLevels ? lastSwingHigh : na, "최근 큰 고점", color = color.new(bearColor, rangeLineTransparency), style = plot.style_linebr, linewidth = rangeLineWidth, linestyle = rangePlotLineStyle)
plot(showSwingLevels ? lastSwingLow : na, "최근 큰 저점", color = color.new(bullColor, rangeLineTransparency), style = plot.style_linebr, linewidth = rangeLineWidth, linestyle = rangePlotLineStyle)

// ─────────────────────────────────────────────────────────────────────────────
// SEQUENCE + SCORE ENGINE
// ─────────────────────────────────────────────────────────────────────────────
bool bullStructureEvent = bullSwingBreak or bullInternalChoch or bullInternalBos
bool bearStructureEvent = bearSwingBreak or bearInternalChoch or bearInternalBos
// 정밀 모드에서는 짧은 내부 BOS 잡음을 구조 확인으로 사용하지 않습니다.
bool bullEntryStructureEvent = bullSwingBreak or bullInternalChoch
bool bearEntryStructureEvent = bearSwingBreak or bearInternalChoch

var int lastBullSweepBar = na
var int lastBearSweepBar = na
var int lastBullStructureBar = na
var int lastBearStructureBar = na
var int lastBullEntryStructureBar = na
var int lastBearEntryStructureBar = na

if bullSweepEvent
    lastBullSweepBar := bar_index
if bearSweepEvent
    lastBearSweepBar := bar_index
if bullStructureEvent
    lastBullStructureBar := bar_index
if bearStructureEvent
    lastBearStructureBar := bar_index
if bullEntryStructureEvent
    lastBullEntryStructureBar := bar_index
if bearEntryStructureEvent
    lastBearEntryStructureBar := bar_index

bool bullSweepRecent = not na(lastBullSweepBar) and bar_index - lastBullSweepBar <= sweepRecentBars
bool bearSweepRecent = not na(lastBearSweepBar) and bar_index - lastBearSweepBar <= sweepRecentBars
bool bullStructureRecent = not na(lastBullStructureBar) and bar_index - lastBullStructureBar <= setupWindow
bool bearStructureRecent = not na(lastBearStructureBar) and bar_index - lastBearStructureBar <= setupWindow
bool bullEntryStructureRecent = not na(lastBullEntryStructureBar) and bar_index - lastBullEntryStructureBar <= setupWindow
bool bearEntryStructureRecent = not na(lastBearEntryStructureBar) and bar_index - lastBearEntryStructureBar <= setupWindow

bool longSequence = bullSweepRecent and bullStructureRecent and
     lastBullSweepBar <= lastBullStructureBar and
     lastBullStructureBar - lastBullSweepBar <= setupWindow and
     bar_index - lastBullStructureBar <= setupWindow

bool shortSequence = bearSweepRecent and bearStructureRecent and
     lastBearSweepBar <= lastBearStructureBar and
     lastBearStructureBar - lastBearSweepBar <= setupWindow and
     bar_index - lastBearStructureBar <= setupWindow

bool longPrecisionSequence = bullSweepRecent and bullEntryStructureRecent and
     lastBullSweepBar <= lastBullEntryStructureBar and
     lastBullEntryStructureBar - lastBullSweepBar <= setupWindow and
     bar_index - lastBullEntryStructureBar <= setupWindow

bool shortPrecisionSequence = bearSweepRecent and bearEntryStructureRecent and
     lastBearSweepBar <= lastBearEntryStructureBar and
     lastBearEntryStructureBar - lastBearSweepBar <= setupWindow and
     bar_index - lastBearEntryStructureBar <= setupWindow

bool bullZoneTouch = inBullFvg or inBullOb
bool bearZoneTouch = inBearFvg or inBearOb

// 정밀 모드용: 구조 확인 뒤 생성된 구간 중 현재 가격과 가장 가까운 구간을 선택합니다.
// 반응 후보 구간(OB)을 가격 빈 구간(FVG)보다 우선하고, 같은 종류는 사용자가 정한 기준 위치가 종가에 가까운 구간을 고릅니다(동률은 최신).
float bullLinkedFvgTop = na
float bullLinkedFvgBottom = na
float bullLinkedFvgDistance = na
int bullLinkedFvgCreatedBar = na
float bullLinkedObTop = na
float bullLinkedObBottom = na
float bullLinkedObDistance = na
int bullLinkedObCreatedBar = na
float bearLinkedFvgTop = na
float bearLinkedFvgBottom = na
float bearLinkedFvgDistance = na
int bearLinkedFvgCreatedBar = na
float bearLinkedObTop = na
float bearLinkedObBottom = na
float bearLinkedObDistance = na
int bearLinkedObCreatedBar = na

if not na(lastBullEntryStructureBar) and array.size(bullFvgBoxes) > 0
    for _i = array.size(bullFvgBoxes) - 1 to 0
        box _b = array.get(bullFvgBoxes, _i)
        int _createdBar = array.get(bullFvgCreatedBars, _i)
        float _top = box.get_top(_b)
        float _bottom = box.get_bottom(_b)
        float _touchThreshold = _top - math.max(_top - _bottom, syminfo.mintick) * effectiveFvgTouchDepthPct / 100.0
        bool _validTouch = _createdBar >= lastBullEntryStructureBar and bar_index > _createdBar and low <= _touchThreshold and high >= _bottom
        if _validTouch
            float _reference = _bottom + (_top - _bottom) * linkedZoneReferencePct / 100.0
            float _distance = math.abs(close - _reference)
            bool _better = na(bullLinkedFvgDistance) or _distance < bullLinkedFvgDistance or (math.abs(_distance - bullLinkedFvgDistance) <= syminfo.mintick and _createdBar > bullLinkedFvgCreatedBar)
            if _better
                bullLinkedFvgTop := _top
                bullLinkedFvgBottom := _bottom
                bullLinkedFvgDistance := _distance
                bullLinkedFvgCreatedBar := _createdBar

if not na(lastBullEntryStructureBar) and array.size(bullObBoxes) > 0
    for _i = array.size(bullObBoxes) - 1 to 0
        box _b = array.get(bullObBoxes, _i)
        int _createdBar = array.get(bullObCreatedBars, _i)
        float _top = box.get_top(_b)
        float _bottom = box.get_bottom(_b)
        float _touchThreshold = _top - math.max(_top - _bottom, syminfo.mintick) * zoneMinDepthPct / 100.0
        bool _validTouch = _createdBar >= lastBullEntryStructureBar and bar_index > _createdBar and low <= _touchThreshold and high >= _bottom and close >= _bottom
        if _validTouch
            float _reference = _bottom + (_top - _bottom) * linkedZoneReferencePct / 100.0
            float _distance = math.abs(close - _reference)
            bool _better = na(bullLinkedObDistance) or _distance < bullLinkedObDistance or (math.abs(_distance - bullLinkedObDistance) <= syminfo.mintick and _createdBar > bullLinkedObCreatedBar)
            if _better
                bullLinkedObTop := _top
                bullLinkedObBottom := _bottom
                bullLinkedObDistance := _distance
                bullLinkedObCreatedBar := _createdBar

if not na(lastBearEntryStructureBar) and array.size(bearFvgBoxes) > 0
    for _i = array.size(bearFvgBoxes) - 1 to 0
        box _b = array.get(bearFvgBoxes, _i)
        int _createdBar = array.get(bearFvgCreatedBars, _i)
        float _top = box.get_top(_b)
        float _bottom = box.get_bottom(_b)
        float _touchThreshold = _bottom + math.max(_top - _bottom, syminfo.mintick) * effectiveFvgTouchDepthPct / 100.0
        bool _validTouch = _createdBar >= lastBearEntryStructureBar and bar_index > _createdBar and high >= _touchThreshold and low <= _top
        if _validTouch
            float _reference = _top - (_top - _bottom) * linkedZoneReferencePct / 100.0
            float _distance = math.abs(close - _reference)
            bool _better = na(bearLinkedFvgDistance) or _distance < bearLinkedFvgDistance or (math.abs(_distance - bearLinkedFvgDistance) <= syminfo.mintick and _createdBar > bearLinkedFvgCreatedBar)
            if _better
                bearLinkedFvgTop := _top
                bearLinkedFvgBottom := _bottom
                bearLinkedFvgDistance := _distance
                bearLinkedFvgCreatedBar := _createdBar

if not na(lastBearEntryStructureBar) and array.size(bearObBoxes) > 0
    for _i = array.size(bearObBoxes) - 1 to 0
        box _b = array.get(bearObBoxes, _i)
        int _createdBar = array.get(bearObCreatedBars, _i)
        float _top = box.get_top(_b)
        float _bottom = box.get_bottom(_b)
        float _touchThreshold = _bottom + math.max(_top - _bottom, syminfo.mintick) * zoneMinDepthPct / 100.0
        bool _validTouch = _createdBar >= lastBearEntryStructureBar and bar_index > _createdBar and high >= _touchThreshold and low <= _top and close <= _top
        if _validTouch
            float _reference = _top - (_top - _bottom) * linkedZoneReferencePct / 100.0
            float _distance = math.abs(close - _reference)
            bool _better = na(bearLinkedObDistance) or _distance < bearLinkedObDistance or (math.abs(_distance - bearLinkedObDistance) <= syminfo.mintick and _createdBar > bearLinkedObCreatedBar)
            if _better
                bearLinkedObTop := _top
                bearLinkedObBottom := _bottom
                bearLinkedObDistance := _distance
                bearLinkedObCreatedBar := _createdBar

bool bullLinkedZoneTouch = not na(bullLinkedObBottom) or not na(bullLinkedFvgBottom)
bool bearLinkedZoneTouch = not na(bearLinkedObTop) or not na(bearLinkedFvgTop)
float bullLinkedZoneTop = not na(bullLinkedObTop) ? bullLinkedObTop : bullLinkedFvgTop
float bullLinkedZoneBottom = not na(bullLinkedObBottom) ? bullLinkedObBottom : bullLinkedFvgBottom
float bearLinkedZoneTop = not na(bearLinkedObTop) ? bearLinkedObTop : bearLinkedFvgTop
float bearLinkedZoneBottom = not na(bearLinkedObBottom) ? bearLinkedObBottom : bearLinkedFvgBottom

int activeZoneWeight = showFVG or showOB ? weightZoneTouch : 0
int activeShockWeight = useShockBonus ? weightShock : 0
int chartWeightTotal = weightTrend + weightStructureTf + weightEntryTf + weightSweep + weightStructureBreak +
     activeZoneWeight + weightVolume + weightEma + weightVwap + activeShockWeight
int longRawScore = 0
longRawScore += mtfTrendState == 1 ? weightTrend : 0
longRawScore += mtfStructureState == 1 ? weightStructureTf : 0
longRawScore += mtfEntryState == 1 ? weightEntryTf : 0
longRawScore += bullSweepRecent ? weightSweep : 0
longRawScore += bullStructureRecent ? weightStructureBreak : 0
longRawScore += bullZoneTouch ? activeZoneWeight : 0
longRawScore += volumeBull ? weightVolume : 0
longRawScore += emaBull ? weightEma : 0
longRawScore += close > vwapValue ? weightVwap : 0
longRawScore += useShockBonus and longShock ? activeShockWeight : 0

int shortRawScore = 0
shortRawScore += mtfTrendState == -1 ? weightTrend : 0
shortRawScore += mtfStructureState == -1 ? weightStructureTf : 0
shortRawScore += mtfEntryState == -1 ? weightEntryTf : 0
shortRawScore += bearSweepRecent ? weightSweep : 0
shortRawScore += bearStructureRecent ? weightStructureBreak : 0
shortRawScore += bearZoneTouch ? activeZoneWeight : 0
shortRawScore += volumeBear ? weightVolume : 0
shortRawScore += emaBear ? weightEma : 0
shortRawScore += close < vwapValue ? weightVwap : 0
shortRawScore += useShockBonus and shortShock ? activeShockWeight : 0

int longScore = chartWeightTotal > 0 ? int(math.round(longRawScore * 14.0 / chartWeightTotal)) : 0
int shortScore = chartWeightTotal > 0 ? int(math.round(shortRawScore * 14.0 / chartWeightTotal)) : 0

bool longPdOk = not requirePD or (not na(discountCeiling) and close <= discountCeiling)
bool shortPdOk = not requirePD or (not na(premiumFloor) and close >= premiumFloor)

bool longSharedBase = not mtfInvalid and longScore >= signalScoreMin and longPdOk
bool shortSharedBase = not mtfInvalid and shortScore >= signalScoreMin and shortPdOk
bool longGeneralRaw = longSharedBase and
     (not requireSequence or longSequence) and
     (not requireZoneTouch or bullZoneTouch)

bool shortGeneralRaw = shortSharedBase and
     (not requireSequence or shortSequence) and
     (not requireZoneTouch or bearZoneTouch)

bool usePrecisionEntry = entryFilterMode == "정밀 (추천)"
string entryModeText = usePrecisionEntry ? "정밀" : "일반"
int precisionRequiredScore = math.max(signalScoreMin, precisionScoreMin)
bool longRaw = usePrecisionEntry ? longSharedBase : longGeneralRaw
bool shortRaw = usePrecisionEntry ? shortSharedBase : shortGeneralRaw

bool longMtfOk = (not precisionRequireTrend or mtfTrendState == 1) and (not precisionRequireStructure or mtfStructureState == 1)
bool shortMtfOk = (not precisionRequireTrend or mtfTrendState == -1) and (not precisionRequireStructure or mtfStructureState == -1)
bool longScoreGapOk = longScore - shortScore >= precisionScoreGap
bool shortScoreGapOk = shortScore - longScore >= precisionScoreGap

bool bullReactionCandle = bullLinkedZoneTouch and not na(lastBullEntryStructureBar) and
     bar_index > lastBullEntryStructureBar and close > open and
     entryCloseLocation >= precisionCloseStrength and entryBodyRatio >= precisionBodyMin
bool bearReactionCandle = bearLinkedZoneTouch and not na(lastBearEntryStructureBar) and
     bar_index > lastBearEntryStructureBar and close < open and
     entryCloseLocation <= 1.0 - precisionCloseStrength and entryBodyRatio >= precisionBodyMin

bool precisionVolumeOk = not precisionUseVolume or na(entryVolumeRatio) or entryVolumeRatio >= precisionVolumeRatio
float precisionAtrLower = math.min(precisionAtrMin, precisionAtrMax)
float precisionAtrUpper = math.max(precisionAtrMin, precisionAtrMax)
bool precisionAtrOk = not precisionUseVolatility or (not na(entryAtrRatio) and entryAtrRatio >= precisionAtrLower and entryAtrRatio <= precisionAtrUpper)
bool precisionRangeOk = not precisionUseVolatility or (not na(atr) and entryCandleRange <= atr * precisionMaxRangeAtr)
bool longChaseOk = not precisionUseVolatility or (not na(atr) and not na(emaFast) and close - emaFast <= atr * precisionMaxChaseAtr)
bool shortChaseOk = not precisionUseVolatility or (not na(atr) and not na(emaFast) and emaFast - close <= atr * precisionMaxChaseAtr)

bool longBaseReady = confirmed and longGeneralRaw and longScore > shortScore
bool shortBaseReady = confirmed and shortGeneralRaw and shortScore > longScore

// 모든 정밀 조건을 먼저 완성한 뒤 edge를 계산해야, 후행 반응봉이 누락되지 않습니다.
bool longPrecisionReady = barClosed and longSharedBase and longScore >= precisionRequiredScore and
     longMtfOk and longScoreGapOk and (not precisionRequireStrongSequence or longPrecisionSequence) and
     (not precisionRequireLinkedZone or bullLinkedZoneTouch) and
     (not precisionRequireReaction or bullReactionCandle) and precisionVolumeOk and precisionAtrOk and
     precisionRangeOk and longChaseOk
bool shortPrecisionReady = barClosed and shortSharedBase and shortScore >= precisionRequiredScore and
     shortMtfOk and shortScoreGapOk and (not precisionRequireStrongSequence or shortPrecisionSequence) and
     (not precisionRequireLinkedZone or bearLinkedZoneTouch) and
     (not precisionRequireReaction or bearReactionCandle) and precisionVolumeOk and precisionAtrOk and
     precisionRangeOk and shortChaseOk

// ── 확정 타점 신뢰 등급: 0~100 신뢰도를 1~5 단계로 환산 ─────────────
// ponytail: 가중치·경계는 고정 heuristic. 표시가 과하거나 부족하면 tierBound 조정.
float longConfidence = math.min(100.0,
     (mtfTrendState == 1 ? 22.0 : 0.0) + (mtfStructureState == 1 ? 16.0 : 0.0) + (mtfEntryState == 1 ? 8.0 : 0.0) +
     (bullSweepRecent ? 10.0 : 0.0) + (bullStructureRecent ? 12.0 : 0.0) + (longPrecisionSequence ? 8.0 : 0.0) +
     (bullLinkedZoneTouch ? 8.0 : 0.0) + (bullReactionCandle ? 8.0 : 0.0) + (emaBull ? 3.0 : 0.0) +
     (close > vwapValue ? 3.0 : 0.0) + (volumeBull ? 2.0 : 0.0) + (longShock ? 2.0 : 0.0))
float shortConfidence = math.min(100.0,
     (mtfTrendState == -1 ? 22.0 : 0.0) + (mtfStructureState == -1 ? 16.0 : 0.0) + (mtfEntryState == -1 ? 8.0 : 0.0) +
     (bearSweepRecent ? 10.0 : 0.0) + (bearStructureRecent ? 12.0 : 0.0) + (shortPrecisionSequence ? 8.0 : 0.0) +
     (bearLinkedZoneTouch ? 8.0 : 0.0) + (bearReactionCandle ? 8.0 : 0.0) + (emaBear ? 3.0 : 0.0) +
     (close < vwapValue ? 3.0 : 0.0) + (volumeBear ? 2.0 : 0.0) + (shortShock ? 2.0 : 0.0))
int longTier = longConfidence >= tierBound5 ? 5 : longConfidence >= tierBound4 ? 4 : longConfidence >= tierBound3 ? 3 : longConfidence >= tierBound2 ? 2 : 1
int shortTier = shortConfidence >= tierBound5 ? 5 : shortConfidence >= tierBound4 ? 4 : shortConfidence >= tierBound3 ? 3 : shortConfidence >= tierBound2 ? 2 : 1
bool longTierBase = longScore > shortScore and (bullSweepRecent or bullStructureRecent or bullLinkedZoneTouch)
bool shortTierBase = shortScore > longScore and (bearSweepRecent or bearStructureRecent or bearLinkedZoneTouch)
bool longTierReady = barClosed and not mtfInvalid and longTierBase and longTier >= entryMinTier
bool shortTierReady = barClosed and not mtfInvalid and shortTierBase and shortTier >= entryMinTier

bool longEligible = useEntryTiers ? longTierReady : usePrecisionEntry ? longPrecisionReady : longBaseReady
bool shortEligible = useEntryTiers ? shortTierReady : usePrecisionEntry ? shortPrecisionReady : shortBaseReady
bool longEntryEdge = longEligible and not longEligible[1]
bool shortEntryEdge = shortEligible and not shortEligible[1]

var int lastLongEntryBar = na
var int lastShortEntryBar = na
bool longCooldownOk = not (usePrecisionEntry or useEntryTiers) or precisionCooldownBars == 0 or na(lastLongEntryBar) or bar_index - lastLongEntryBar >= precisionCooldownBars
bool shortCooldownOk = not (usePrecisionEntry or useEntryTiers) or precisionCooldownBars == 0 or na(lastShortEntryBar) or bar_index - lastShortEntryBar >= precisionCooldownBars
bool longSignal = longEntryEdge and longCooldownOk
bool shortSignal = shortEntryEdge and shortCooldownOk
bool longEntryCandidate = barClosed and longSignal
bool shortEntryCandidate = barClosed and shortSignal

if longEntryCandidate
    lastLongEntryBar := bar_index
if shortEntryCandidate
    lastShortEntryBar := bar_index

string longPrecisionReason = precisionRequireTrend and mtfTrendState != 1 ? "큰 흐름 다름" :
     precisionRequireStructure and mtfStructureState != 1 ? "중간 흐름 다름" :
     longScore < precisionRequiredScore ? "점수 미달" :
     not longScoreGapOk ? "점수차 부족" :
     precisionRequireStrongSequence and not longPrecisionSequence ? "순서 미완료" :
     precisionRequireLinkedZone and not bullLinkedZoneTouch ? "구간 미접촉" :
     precisionRequireReaction and not bullReactionCandle ? "반응봉 없음" :
     not precisionVolumeOk ? "거래량 미달" :
     not precisionAtrOk ? "변동폭 범위 밖" :
     not precisionRangeOk ? "큰 봉 제외" :
     not longChaseOk ? "평균선과 멂" : "조건 충족"

string shortPrecisionReason = precisionRequireTrend and mtfTrendState != -1 ? "큰 흐름 다름" :
     precisionRequireStructure and mtfStructureState != -1 ? "중간 흐름 다름" :
     shortScore < precisionRequiredScore ? "점수 미달" :
     not shortScoreGapOk ? "점수차 부족" :
     precisionRequireStrongSequence and not shortPrecisionSequence ? "순서 미완료" :
     precisionRequireLinkedZone and not bearLinkedZoneTouch ? "구간 미접촉" :
     precisionRequireReaction and not bearReactionCandle ? "반응봉 없음" :
     not precisionVolumeOk ? "거래량 미달" :
     not precisionAtrOk ? "변동폭 범위 밖" :
     not precisionRangeOk ? "큰 봉 제외" :
     not shortChaseOk ? "평균선과 멂" : "조건 충족"

// ─────────────────────────────────────────────────────────────────────────────
// ENTRY · TP1 · TP2 · SL REFERENCE PLAN
// 확정 후보봉 종가를 기준으로 계산하는 시각적 계획이며 실제 주문을 실행하지 않습니다.
// ─────────────────────────────────────────────────────────────────────────────
var int tradePlanState = 0          // 0=없음, 1=TP1 전, 2=TP1 후
var int tradePlanDirection = 0      // 1=상승, -1=하락
var int tradePlanEntryBar = na
var float tradePlanEntry = na
var float tradePlanSl = na
var float tradePlanTp1 = na
var float tradePlanTp2 = na
var float tradePlanRisk = na
var float tradePlanRiskPercent = na
var bool tradePlanTp1Reached = false
var string lastTradeResultText = ""
var int lastTradeResultBar = na
var color lastTradeResultColor = na

var line activeTradeEntryLine = na
var line activeTradeTp1Line = na
var line activeTradeTp2Line = na
var line activeTradeSlLine = na
var box activeTradeRewardBox = na
var box activeTradeRiskBox = na
var label activeTradeEntryTag = na
var label activeTradeEntryLabel = na
var label activeTradeTp1Label = na
var label activeTradeTp2Label = na
var label activeTradeSlLabel = na

var tradeEntryLineHistory = array.new_line(0)
var tradeTp1LineHistory = array.new_line(0)
var tradeTp2LineHistory = array.new_line(0)
var tradeSlLineHistory = array.new_line(0)
var tradeRewardBoxHistory = array.new_box(0)
var tradeRiskBoxHistory = array.new_box(0)
var tradeEntryTagHistory = array.new_label(0)
var tradeEntryLabelHistory = array.new_label(0)
var tradeTp1LabelHistory = array.new_label(0)
var tradeTp2LabelHistory = array.new_label(0)
var tradeSlLabelHistory = array.new_label(0)

bool tradePlanLongEntryEvent = false
bool tradePlanShortEntryEvent = false
bool tradePlanTp1Event = false
bool tradePlanTp2Event = false
bool tradePlanSlEvent = false
bool tradePlanAmbiguousEvent = false
bool tradePlanTimeoutEvent = false
bool tradePlanRiskRejectedEvent = false
bool tradePlanClosedThisBar = false

// 기존 계획의 결과를 먼저 판정합니다. 엔트리봉 자체는 판정에서 제외합니다.
if showTradePlan and tradePlanState > 0 and barClosed and bar_index > tradePlanEntryBar
    bool _isLong = tradePlanDirection == 1
    bool _slTouched = _isLong ? low <= tradePlanSl : high >= tradePlanSl
    bool _tp1Touched = _isLong ? high >= tradePlanTp1 : low <= tradePlanTp1
    bool _tp2Touched = _isLong ? high >= tradePlanTp2 : low <= tradePlanTp2
    bool _gapSl = _isLong ? open <= tradePlanSl : open >= tradePlanSl
    bool _gapTp1 = _isLong ? open >= tradePlanTp1 : open <= tradePlanTp1
    bool _gapTp2 = _isLong ? open >= tradePlanTp2 : open <= tradePlanTp2

    if tradePlanState == 1
        if _gapSl
            tradePlanSlEvent := true
        else if _gapTp2
            tradePlanTp1Event := true
            tradePlanTp2Event := true
        else if _gapTp1
            tradePlanTp1Event := true
            if _slTouched and _tp2Touched
                tradePlanAmbiguousEvent := true
            else if _tp2Touched
                tradePlanTp2Event := true
            else if _slTouched
                tradePlanSlEvent := true
            else
                tradePlanState := 2
        else if _slTouched and (_tp1Touched or _tp2Touched)
            tradePlanAmbiguousEvent := true
        else if _slTouched
            tradePlanSlEvent := true
        else if _tp2Touched
            tradePlanTp1Event := true
            tradePlanTp2Event := true
        else if _tp1Touched
            tradePlanTp1Event := true
            tradePlanState := 2
    else if tradePlanState == 2
        if _gapSl
            tradePlanSlEvent := true
        else if _gapTp2
            tradePlanTp2Event := true
        else if _slTouched and _tp2Touched
            tradePlanAmbiguousEvent := true
        else if _slTouched
            tradePlanSlEvent := true
        else if _tp2Touched
            tradePlanTp2Event := true

    if tradePlanTp1Event
        tradePlanTp1Reached := true
        if not na(activeTradeTp1Label)
            label.set_text(activeTradeTp1Label, beginnerView ? "✓ 첫 목표 도착" : "✓ 목표 1")

    if tradePlanTp2Event or tradePlanSlEvent or tradePlanAmbiguousEvent
        tradePlanState := 0
        tradePlanClosedThisBar := true

    if not tradePlanClosedThisBar and tradePlanState > 0 and bar_index - tradePlanEntryBar >= tradeMaxHoldBars
        tradePlanTimeoutEvent := true
        tradePlanState := 0
        tradePlanClosedThisBar := true

    if tradePlanClosedThisBar
        string _resultText = useEntryTiers ?
             (tradePlanTp2Event ? "TP2 도달" : tradePlanSlEvent ? (tradePlanTp1Reached ? "TP1후 SL" : "SL 도달") : tradePlanAmbiguousEvent ? "TP·SL 동시" : "기간 종료") :
             beginnerView ?
             (tradePlanTp2Event ? "마지막 목표 도착" :
              tradePlanSlEvent ? (tradePlanTp1Reached ? "첫 목표 후 계획 중단선" : "계획 중단선 닿음") :
              tradePlanAmbiguousEvent ? (tradePlanTp1Reached ? "첫 목표 후 둘 다 닿음 · 순서 모름" : "둘 다 닿음 · 순서 모름") :
              tradePlanTp1Reached ? "첫 목표 후 관찰 기간 종료" : "관찰 기간 종료") :
             (tradePlanTp2Event ? "목표 2 도달 · 종료" :
              tradePlanSlEvent ? (tradePlanTp1Reached ? "목표 1 후 손절 기준" : "손절 기준 도달 · 종료") :
              tradePlanAmbiguousEvent ? (tradePlanTp1Reached ? "목표 1 후 동시 접촉 · 순서 불명" : "동시 접촉 · 순서 불명") :
              tradePlanTp1Reached ? "목표 1 후 기간 종료" : "기간 종료")
        color _resultColor = tradePlanTp2Event ? tradeTp2Color : tradePlanSlEvent ? tradeSlColor : warningColor
        lastTradeResultText := _resultText
        lastTradeResultBar := bar_index
        lastTradeResultColor := _resultColor
        if not na(activeTradeEntryTag)
            string _resultPrefix = useEntryTiers ? (tradePlanDirection == 1 ? "🟢 롱 · " : "🔴 숏 · ") : beginnerView ? (tradePlanDirection == 1 ? "🟢 상승 검토 끝\n" : "🔵 하락 검토 끝\n") : (tradePlanDirection == 1 ? "▲ 상승 계획\n" : "▼ 하락 계획\n")
            label.set_text(activeTradeEntryTag, _resultPrefix + _resultText)
            label.set_color(activeTradeEntryTag, color.new(_resultColor, tradeLabelTransparency))
        if tradePlanTp2Event and not na(activeTradeTp2Label)
            label.set_text(activeTradeTp2Label, beginnerView ? "✓ 마지막 목표" : "✓ 목표 2")
        if tradePlanSlEvent and not na(activeTradeSlLabel)
            label.set_text(activeTradeSlLabel, beginnerView ? "✋ 계획 중단선" : "✓ 손절 기준")
        if tradePlanAmbiguousEvent
            if _tp2Touched and not na(activeTradeTp2Label)
                label.set_text(activeTradeTp2Label, "? 목표 2·손절 순서 불명")
            else if _tp1Touched and not na(activeTradeTp1Label)
                label.set_text(activeTradeTp1Label, "? 목표 1·손절 순서 불명")
            if not na(activeTradeSlLabel)
                label.set_text(activeTradeSlLabel, "? 동시 접촉")
        if not na(activeTradeEntryLine)
            line.set_x2(activeTradeEntryLine, bar_index)
        if not na(activeTradeTp1Line)
            line.set_x2(activeTradeTp1Line, bar_index)
        if not na(activeTradeTp2Line)
            line.set_x2(activeTradeTp2Line, bar_index)
        if not na(activeTradeSlLine)
            line.set_x2(activeTradeSlLine, bar_index)
        if not na(activeTradeRewardBox)
            box.set_right(activeTradeRewardBox, bar_index)
        if not na(activeTradeRiskBox)
            box.set_right(activeTradeRiskBox, bar_index)
        if not na(activeTradeEntryLabel)
            label.set_x(activeTradeEntryLabel, bar_index)
        if not na(activeTradeTp1Label)
            label.set_x(activeTradeTp1Label, bar_index)
        if not na(activeTradeTp2Label)
            label.set_x(activeTradeTp2Label, bar_index)
        if not na(activeTradeSlLabel)
            label.set_x(activeTradeSlLabel, bar_index)

// 새 타점이 나오면 방향과 무관하게 최신 타점으로 교체합니다(롱·숏 모두 표시). 같은 봉 종료 직후만 대기.
bool tradePlanCanStart = showTradePlan and not tradePlanClosedThisBar
if tradePlanCanStart and (longEntryCandidate or shortEntryCandidate)
    int _direction = longEntryCandidate ? 1 : -1
    float _entry = math.round_to_mintick(close)
    float _entryAtr = not na(atr) and atr > 0 ? atr : entryCandleRange
    float _zoneBoundary = _direction == 1 ? bullLinkedZoneBottom : bearLinkedZoneTop
    float _slBase = _direction == 1 ? (not na(_zoneBoundary) ? math.min(low, _zoneBoundary) : low) : (not na(_zoneBoundary) ? math.max(high, _zoneBoundary) : high)
    float _rawSl = _direction == 1 ? _slBase - _entryAtr * tradeSlAtrBuffer : _slBase + _entryAtr * tradeSlAtrBuffer
    float _rawRisk = _direction == 1 ? _entry - _rawSl : _rawSl - _entry
    float _minimumRisk = math.max(_entryAtr * tradeMinRiskAtr, syminfo.mintick * tradeMinRiskTicks)
    float _risk = math.max(_rawRisk, _minimumRisk)
    float _slCandidate = _direction == 1 ? _entry - _risk : _entry + _risk
    // 손절 버퍼가 최근접 반올림으로 구간 안쪽에 들어오지 않도록 방향별로 바깥쪽 틱에 맞춥니다.
    float _sl = math.round_to_mintick((_direction == 1 ? math.floor(_slCandidate / syminfo.mintick) : math.ceil(_slCandidate / syminfo.mintick)) * syminfo.mintick)
    _risk := math.abs(_entry - _sl)
    float _maximumRisk = math.max(_entryAtr * tradeMaxRiskAtr, _minimumRisk)
    bool _riskTooWide = _sl <= 0 or _risk > _maximumRisk
    float _tp2R = math.max(tradeTp2R, tradeTp1R + tradeMinTargetGapR)
    float _tp1Candidate = math.round_to_mintick(_direction == 1 ? _entry + _risk * tradeTp1R : _entry - _risk * tradeTp1R)
    float _tp1 = math.round_to_mintick(_direction == 1 ? math.max(_tp1Candidate, _entry + syminfo.mintick * tradeMinTargetGapTicks) : math.min(_tp1Candidate, _entry - syminfo.mintick * tradeMinTargetGapTicks))
    float _tp2Candidate = math.round_to_mintick(_direction == 1 ? _entry + _risk * _tp2R : _entry - _risk * _tp2R)
    float _tp2 = math.round_to_mintick(_direction == 1 ? math.max(_tp2Candidate, _tp1 + syminfo.mintick * tradeMinTargetGapTicks) : math.min(_tp2Candidate, _tp1 - syminfo.mintick * tradeMinTargetGapTicks))
    int _rightBar = bar_index + tradePlanRightBars
    float _riskPercent = _entry != 0 ? _risk / math.abs(_entry) * 100.0 : na

    if _riskTooWide
        tradePlanRiskRejectedEvent := true
        lastTradeResultText := "계획선 생략 · 위험거리 큼"
        lastTradeResultBar := bar_index
        lastTradeResultColor := warningColor
        float _riskAtr = _entryAtr > 0 ? _risk / _entryAtr : na
        string _rejectReason = _sl <= 0 ? "손절 가격 부적합" : "손절 거리 큼 · " + str.tostring(_riskAtr, "#.##") + " ATR"
        if showTradeLabels
            label.new(bar_index, _direction == 1 ? low : high,
                 useEntryTiers ? "🟠 생략 · 위험 큼" : (beginnerView ? "🟠 계획선 생략\n" : "⚠ 계획 생략\n") + (beginnerView ? "중단선이 너무 멀어요" : _rejectReason),
                 xloc = xloc.bar_index, yloc = _direction == 1 ? yloc.belowbar : yloc.abovebar,
                 style = _direction == 1 ? label.style_label_up : label.style_label_down,
                 color = color.new(warningColor, signalLabelTransparency), textcolor = panelColor, size = f_textSize(signalLabelSizeInput))
    else
        lastTradeResultText := ""
        lastTradeResultBar := na
        lastTradeResultColor := na
        tradePlanState := 1
        tradePlanDirection := _direction
        tradePlanEntryBar := bar_index
        tradePlanEntry := _entry
        tradePlanSl := _sl
        tradePlanTp1 := _tp1
        tradePlanTp2 := _tp2
        tradePlanRisk := _risk
        tradePlanRiskPercent := _riskPercent
        tradePlanTp1Reached := false
        tradePlanLongEntryEvent := _direction == 1
        tradePlanShortEntryEvent := _direction == -1

        activeTradeEntryLine := line.new(bar_index, _entry, _rightBar, _entry, xloc = xloc.bar_index, extend = extend.none, color = tradeEntryColor, style = f_lineStyle(tradeEntryLineStyleInput), width = tradeEntryLineWidth)
        activeTradeTp1Line := line.new(bar_index, _tp1, _rightBar, _tp1, xloc = xloc.bar_index, extend = extend.none, color = tradeTp1Color, style = f_lineStyle(tradeTp1LineStyleInput), width = tradeTp1LineWidth)
        activeTradeTp2Line := line.new(bar_index, _tp2, _rightBar, _tp2, xloc = xloc.bar_index, extend = extend.none, color = tradeTp2Color, style = f_lineStyle(tradeTp2LineStyleInput), width = tradeTp2LineWidth)
        activeTradeSlLine := line.new(bar_index, _sl, _rightBar, _sl, xloc = xloc.bar_index, extend = extend.none, color = tradeSlColor, style = f_lineStyle(tradeSlLineStyleInput), width = tradeSlLineWidth)

        float _rewardTop = _direction == 1 ? _tp2 : _entry
        float _rewardBottom = _direction == 1 ? _entry : _tp2
        float _riskTop = _direction == 1 ? _entry : _sl
        float _riskBottom = _direction == 1 ? _sl : _entry
        activeTradeRewardBox := showTradeAreaBoxes ? box.new(bar_index, _rewardTop, _rightBar, _rewardBottom, xloc = xloc.bar_index, border_color = color.new(tradeTp2Color, tradeAreaBorderTransparency), border_width = tradeAreaBorderWidth, border_style = f_lineStyle(tradeAreaBorderStyleInput), bgcolor = color.new(tradeTp2Color, tradeRewardTransparency)) : na
        activeTradeRiskBox := showTradeAreaBoxes ? box.new(bar_index, _riskTop, _rightBar, _riskBottom, xloc = xloc.bar_index, border_color = color.new(tradeSlColor, tradeAreaBorderTransparency), border_width = tradeAreaBorderWidth, border_style = f_lineStyle(tradeAreaBorderStyleInput), bgcolor = color.new(tradeSlColor, tradeRiskTransparency)) : na

        int _tier = _direction == 1 ? longTier : shortTier
        string _directionText = useEntryTiers ?
             (_direction == 1 ? "🟢 롱 " : "🔴 숏 ") + str.tostring(_tier) + (showTierStars ? " " + f_stars(_tier) : "") :
             beginnerView ? (_direction == 1 ? "🟢 상승 검토 후보" : "🔵 하락 검토 후보") : (_direction == 1 ? "▲ 상승 참고 계획" : "▼ 하락 참고 계획")
        string _entryTagText = useEntryTiers ? _directionText :
             beginnerView ? _directionText + "\n봉이 닫힌 뒤 확인 · 자동 주문 아님" : _directionText + "\n" + str.tostring(_entry, format.mintick) + " · 위험폭 " + str.tostring(_riskPercent, "#.##") + "%"
        activeTradeEntryTag := showTradeLabels ? label.new(bar_index, _entry, _entryTagText, xloc = xloc.bar_index, yloc = yloc.price, style = _direction == 1 ? label.style_label_up : label.style_label_down, color = color.new(_direction == 1 ? bullColor : bearColor, signalLabelTransparency), textcolor = _direction == 1 ? panelColor : color.white, size = f_textSize(signalLabelSizeInput)) : na
        activeTradeEntryLabel := showTradeLabels ? label.new(_rightBar, _entry, (beginnerView ? "① 보는 가격" : "진입 기준"), xloc = xloc.bar_index, yloc = yloc.price, style = label.style_label_left, color = color.new(tradeEntryColor, tradeLabelTransparency), textcolor = color.white, size = f_textSize(planLabelSizeInput)) : na
        activeTradeTp1Label := showTradeLabels ? label.new(_rightBar, _tp1, (beginnerView ? "② 첫 목표" : "목표 1"), xloc = xloc.bar_index, yloc = yloc.price, style = label.style_label_left, color = color.new(tradeTp1Color, tradeLabelTransparency), textcolor = panelColor, size = f_textSize(planLabelSizeInput)) : na
        activeTradeTp2Label := showTradeLabels ? label.new(_rightBar, _tp2, (beginnerView ? "③ 마지막 목표" : "목표 2"), xloc = xloc.bar_index, yloc = yloc.price, style = label.style_label_left, color = color.new(tradeTp2Color, tradeLabelTransparency), textcolor = panelColor, size = f_textSize(planLabelSizeInput)) : na
        activeTradeSlLabel := showTradeLabels ? label.new(_rightBar, _sl, (beginnerView ? "✋ 계획 중단선" : "손절 기준"), xloc = xloc.bar_index, yloc = yloc.price, style = label.style_label_left, color = color.new(tradeSlColor, tradeLabelTransparency), textcolor = color.white, size = f_textSize(planLabelSizeInput)) : na

        array.push(tradeEntryLineHistory, activeTradeEntryLine)
        array.push(tradeTp1LineHistory, activeTradeTp1Line)
        array.push(tradeTp2LineHistory, activeTradeTp2Line)
        array.push(tradeSlLineHistory, activeTradeSlLine)
        array.push(tradeRewardBoxHistory, activeTradeRewardBox)
        array.push(tradeRiskBoxHistory, activeTradeRiskBox)
        array.push(tradeEntryTagHistory, activeTradeEntryTag)
        array.push(tradeEntryLabelHistory, activeTradeEntryLabel)
        array.push(tradeTp1LabelHistory, activeTradeTp1Label)
        array.push(tradeTp2LabelHistory, activeTradeTp2Label)
        array.push(tradeSlLabelHistory, activeTradeSlLabel)

        while array.size(tradeEntryLineHistory) > (showPastPositions ? tradePlanHistoryCount : 1)
            line.delete(array.shift(tradeEntryLineHistory))
            line.delete(array.shift(tradeTp1LineHistory))
            line.delete(array.shift(tradeTp2LineHistory))
            line.delete(array.shift(tradeSlLineHistory))
            box.delete(array.shift(tradeRewardBoxHistory))
            box.delete(array.shift(tradeRiskBoxHistory))
            label.delete(array.shift(tradeEntryTagHistory))
            label.delete(array.shift(tradeEntryLabelHistory))
            label.delete(array.shift(tradeTp1LabelHistory))
            label.delete(array.shift(tradeTp2LabelHistory))
            label.delete(array.shift(tradeSlLabelHistory))

// 활성 계획의 오른쪽 끝과 가격표만 이동하며 ENTRY·TP·SL 가격은 고정합니다.
if showTradePlan and tradePlanState > 0
    int _activeRightBar = bar_index + tradePlanRightBars
    line.set_x2(activeTradeEntryLine, _activeRightBar)
    line.set_x2(activeTradeTp1Line, _activeRightBar)
    line.set_x2(activeTradeTp2Line, _activeRightBar)
    line.set_x2(activeTradeSlLine, _activeRightBar)
    if not na(activeTradeRewardBox)
        box.set_right(activeTradeRewardBox, _activeRightBar)
    if not na(activeTradeRiskBox)
        box.set_right(activeTradeRiskBox, _activeRightBar)
    if showTradeLabels
        label.set_x(activeTradeEntryLabel, _activeRightBar)
        label.set_x(activeTradeTp1Label, _activeRightBar)
        label.set_x(activeTradeTp2Label, _activeRightBar)
        label.set_x(activeTradeSlLabel, _activeRightBar)

// 하나의 계획이 진행 중이거나 같은 봉에서 종료됐다면 새 후보는 기록만 소비하고 화면·알림에는 중복 표시하지 않습니다.
bool longUnplannedCandidateEvent = longEntryCandidate and not tradePlanLongEntryEvent and not tradePlanRiskRejectedEvent and
     (not showTradePlan or (tradePlanState == 0 and not tradePlanClosedThisBar))
bool shortUnplannedCandidateEvent = shortEntryCandidate and not tradePlanShortEntryEvent and not tradePlanRiskRejectedEvent and
     (not showTradePlan or (tradePlanState == 0 and not tradePlanClosedThisBar))
bool longCandidateVisualEvent = tradePlanLongEntryEvent or longUnplannedCandidateEvent or (longEntryCandidate and tradePlanRiskRejectedEvent)
bool shortCandidateVisualEvent = tradePlanShortEntryEvent or shortUnplannedCandidateEvent or (shortEntryCandidate and tradePlanRiskRejectedEvent)

if tradePlanLongEntryEvent
    alert("상승 참고 계획 시작 | " + syminfo.ticker + (useEntryTiers ? " | 롱 타점 " + str.tostring(longTier) + "/5" : "") + " | 보는 가격 " + str.tostring(tradePlanEntry, format.mintick) + " | 첫 목표 " + str.tostring(tradePlanTp1, format.mintick) + " | 마지막 목표 " + str.tostring(tradePlanTp2, format.mintick) + " | 중단선 " + str.tostring(tradePlanSl, format.mintick) + " | 자동 주문 아님", alert.freq_once_per_bar_close)
if tradePlanShortEntryEvent
    alert("하락 참고 계획 시작 | " + syminfo.ticker + (useEntryTiers ? " | 숏 타점 " + str.tostring(shortTier) + "/5" : "") + " | 보는 가격 " + str.tostring(tradePlanEntry, format.mintick) + " | 첫 목표 " + str.tostring(tradePlanTp1, format.mintick) + " | 마지막 목표 " + str.tostring(tradePlanTp2, format.mintick) + " | 중단선 " + str.tostring(tradePlanSl, format.mintick) + " | 자동 주문 아님", alert.freq_once_per_bar_close)
if tradePlanTp1Event and not tradePlanTp2Event and not tradePlanSlEvent and not tradePlanAmbiguousEvent and not tradePlanTimeoutEvent
    alert("첫 목표 기준 도달 | " + syminfo.ticker + " | " + str.tostring(tradePlanTp1, format.mintick) + " | 실제 청산 아님", alert.freq_once_per_bar_close)
if tradePlanTp2Event
    alert("마지막 목표 기준 도달 | " + syminfo.ticker + " | " + str.tostring(tradePlanTp2, format.mintick) + " | 계획 종료 | 실제 청산 아님", alert.freq_once_per_bar_close)
if tradePlanSlEvent
    alert("계획 중단선 도달 | " + syminfo.ticker + " | " + str.tostring(tradePlanSl, format.mintick) + " | 계획 종료 | 실제 주문·체결 아님", alert.freq_once_per_bar_close)
if tradePlanAmbiguousEvent
    alert("목표·중단선 동시 접촉 | " + syminfo.ticker + " | " + (tradePlanTp1Reached ? "첫 목표 확인 후 " : "") + "봉 내부 순서 확인 불가 | 계획 종료", alert.freq_once_per_bar_close)
if tradePlanTimeoutEvent
    alert("참고 계획 관찰 기간 종료 | " + syminfo.ticker + " | " + (tradePlanTp1Reached ? "첫 목표 도달 후 " : "") + "마지막 목표·중단선 미도달 | 자동 주문 아님", alert.freq_once_per_bar_close)
if tradePlanRiskRejectedEvent
    alert("참고 계획선 생략 | " + syminfo.ticker + " | 중단선 가격 또는 위험 범위 부적합 | 자동 주문 아님", alert.freq_once_per_bar_close)

if longUnplannedCandidateEvent and showSignals
    label.new(bar_index, low, beginnerView ? "🟢 상승 검토 후보\n봉이 닫힌 뒤 확인" : "▲ 상승 검토 후보\n" + str.tostring(longScore) + "/14 · " + entryModeText,
         xloc = xloc.bar_index, yloc = yloc.belowbar,
         style = label.style_label_up, color = color.new(bullColor, signalLabelTransparency),
         textcolor = panelColor, size = f_textSize(signalLabelSizeInput))

if shortUnplannedCandidateEvent and showSignals
    label.new(bar_index, high, beginnerView ? "🔵 하락 검토 후보\n새 매수 후보 아님" : "▼ 하락 검토 후보\n" + str.tostring(shortScore) + "/14 · " + entryModeText,
         xloc = xloc.bar_index, yloc = yloc.abovebar,
         style = label.style_label_down, color = color.new(bearColor, signalLabelTransparency),
         textcolor = color.white, size = f_textSize(signalLabelSizeInput))

if longUnplannedCandidateEvent
    alert("현재 차트 상승 검토 후보 | " + syminfo.ticker + " | " + entryModeText + " 선별 | 조건점수 " + str.tostring(longScore) + "/14 | 표시봉 종가 " + str.tostring(close, format.mintick) + " | 관찰용",
         alert.freq_once_per_bar_close)

if shortUnplannedCandidateEvent
    alert("현재 차트 하락 검토 후보 | " + syminfo.ticker + " | " + entryModeText + " 선별 | 조건점수 " + str.tostring(shortScore) + "/14 | 표시봉 종가 " + str.tostring(close, format.mintick) + " | 관찰용",
         alert.freq_once_per_bar_close)

barcolor(showSignals and paintSignalBar and longCandidateVisualEvent ? color.new(bullColor, signalBarTransparency) : showSignals and paintSignalBar and shortCandidateVisualEvent ? color.new(bearColor, signalBarTransparency) : na)
bgcolor(showSignals and paintSignalBar and longCandidateVisualEvent ? color.new(bullColor, signalBgTransparency) : showSignals and paintSignalBar and shortCandidateVisualEvent ? color.new(bearColor, signalBgTransparency) : na, title = "검토 후보 강조")

// ─────────────────────────────────────────────────────────────────────────────
// ALERTS
// ─────────────────────────────────────────────────────────────────────────────
alertcondition(longUnplannedCandidateEvent, "현재 차트 상승 검토 후보",
     "상승 검토 후보 | {{exchange}}:{{ticker}} | 시간봉={{interval}} | 표시봉 종가={{close}} | 선별 모드는 지표 설정 따름 | 관찰용")

alertcondition(shortUnplannedCandidateEvent, "현재 차트 하락 검토 후보",
     "하락 검토 후보 | {{exchange}}:{{ticker}} | 시간봉={{interval}} | 표시봉 종가={{close}} | 선별 모드는 지표 설정 따름 | 관찰용")

alertcondition(tradePlanLongEntryEvent, "상승 참고 계획 시작",
     "상승 참고 계획 시작 | {{exchange}}:{{ticker}} | 시간봉={{interval}} | 확정봉 종가 기준 | 자동 주문 아님")

alertcondition(tradePlanShortEntryEvent, "하락 참고 계획 시작",
     "하락 참고 계획 시작 | {{exchange}}:{{ticker}} | 시간봉={{interval}} | 확정봉 종가 기준 | 자동 주문 아님")

alertcondition(tradePlanTp1Event and not tradePlanTp2Event and not tradePlanSlEvent and not tradePlanAmbiguousEvent and not tradePlanTimeoutEvent, "첫 목표 기준 도달",
     "첫 목표 기준 도달 | {{exchange}}:{{ticker}} | 실제 청산 아님")

alertcondition(tradePlanTp2Event, "마지막 목표 기준 도달",
     "마지막 목표 기준 도달 | {{exchange}}:{{ticker}} | 계획 종료 | 실제 청산 아님")

alertcondition(tradePlanSlEvent, "계획 중단선 도달",
     "계획 중단선 도달 | {{exchange}}:{{ticker}} | 계획 종료 | 실제 주문·체결 아님")

alertcondition(tradePlanAmbiguousEvent, "목표·중단선 동시 접촉",
     "목표·중단선 동시 접촉 | {{exchange}}:{{ticker}} | 봉 내부 순서 확인 불가")

alertcondition(tradePlanTimeoutEvent, "참고 계획 관찰 기간 종료",
     "참고 계획 관찰 기간 종료 | {{exchange}}:{{ticker}} | 마지막 목표·중단선 미도달 | 자동 주문 아님")

alertcondition(tradePlanRiskRejectedEvent, "참고 계획 위험폭 초과",
     "참고 계획선 생략 | {{exchange}}:{{ticker}} | 중단선 가격 또는 위험 범위 부적합 | 자동 주문 아님")

alertcondition(barClosed and bullSweepEvent, "저점을 찍고 복귀",
     "저점을 찍고 복귀 | {{exchange}}:{{ticker}} | 시간봉={{interval}}")

alertcondition(barClosed and bearSweepEvent, "고점을 찍고 복귀",
     "고점을 찍고 복귀 | {{exchange}}:{{ticker}} | 시간봉={{interval}}")

alertcondition(barClosed and (bullSwingChoch or bullInternalChoch), "상승 방향 흐름 전환",
     "상승 방향 흐름 전환 | {{exchange}}:{{ticker}} | 시간봉={{interval}}")

alertcondition(barClosed and (bearSwingChoch or bearInternalChoch), "하락 방향 흐름 전환",
     "하락 방향 흐름 전환 | {{exchange}}:{{ticker}} | 시간봉={{interval}}")

// ─────────────────────────────────────────────────────────────────────────────
// DASHBOARD
// ─────────────────────────────────────────────────────────────────────────────
var table dash = table.new(dashPosition, beginnerView ? 1 : 3, beginnerView ? 3 : 9,
     bgcolor = color.new(panelColor, panelBgTransparency),
     frame_color = color.new(panelBorderColor, panelFrameTransparency),
     frame_width = panelFrameWidth,
     border_color = color.new(panelBorderColor, panelGridTransparency),
     border_width = panelGridWidth)

if barstate.isfirst and not beginnerView
    table.merge_cells(dash, 0, 0, 2, 0)
    table.merge_cells(dash, 0, 8, 2, 8)

bool useSimpleDashboard = showDashboard and beginnerView and showBeginnerGuide
bool useDetailedDashboard = showDashboard and not beginnerView

if barstate.islast and useDetailedDashboard
    string _statusText = mtfInvalid ? "시간봉 오류" : entryModeText + " · 봉 마감"
    color _statusColor = mtfInvalid ? tradeSlColor : bullColor
    color _longScoreBg = color.new(color.from_gradient(longScore, 0, 14, panelAltColor, bullColor), directionCellTransparency)
    color _shortScoreBg = color.new(color.from_gradient(shortScore, 0, 14, panelAltColor, bearColor), directionCellTransparency)
    bool _longRejected = longEntryCandidate and tradePlanRiskRejectedEvent
    bool _shortRejected = shortEntryCandidate and tradePlanRiskRejectedEvent
    bool _longNewVisible = tradePlanLongEntryEvent or longUnplannedCandidateEvent
    bool _shortNewVisible = tradePlanShortEntryEvent or shortUnplannedCandidateEvent
    string _longState = _longRejected ? "위험폭 큼" :
         _longNewVisible ? "새 후보" :
         longEntryEdge and not longCooldownOk ? "재표시 대기" :
         longEligible ? "조건 유지" :
         usePrecisionEntry and longRaw and longScore > shortScore ? (not barClosed ? "봉 마감 대기" : longPrecisionReason) :
         longRaw and not confirmed ? "봉 마감 대기" : longRaw ? "점수 우세 없음" : "조건 부족"
    string _shortState = _shortRejected ? "위험폭 큼" :
         _shortNewVisible ? "새 후보" :
         shortEntryEdge and not shortCooldownOk ? "재표시 대기" :
         shortEligible ? "조건 유지" :
         usePrecisionEntry and shortRaw and shortScore > longScore ? (not barClosed ? "봉 마감 대기" : shortPrecisionReason) :
         shortRaw and not confirmed ? "봉 마감 대기" : shortRaw ? "점수 우세 없음" : "조건 부족"
    bool _longWaiting = longEntryEdge and not longCooldownOk or (usePrecisionEntry and longRaw and longScore > shortScore) or (longRaw and not confirmed)
    bool _shortWaiting = shortEntryEdge and not shortCooldownOk or (usePrecisionEntry and shortRaw and shortScore > longScore) or (shortRaw and not confirmed)
    color _longStateColor = _longRejected ? warningColor : (_longNewVisible or longEligible) ? bullColor : _longWaiting ? warningColor : panelMutedColor
    color _shortStateColor = _shortRejected ? warningColor : (_shortNewVisible or shortEligible) ? bearColor : _shortWaiting ? warningColor : panelMutedColor

    table.cell(dash, 0, 0, "현재 차트 · " + _statusText + " · " + f_tfLabel(timeframe.period),
         text_color = panelTextColor, bgcolor = color.new(_statusColor, panelHeaderTransparency), text_size = dashTextSize)

    table.cell(dash, 0, 1, "구분", text_color = panelMutedColor, bgcolor = panelAltColor, text_size = size.tiny)
    table.cell(dash, 1, 1, "시간·점수", text_color = panelMutedColor, bgcolor = panelAltColor, text_size = size.tiny)
    table.cell(dash, 2, 1, "상태", text_color = panelMutedColor, bgcolor = panelAltColor, text_size = size.tiny)

    table.cell(dash, 0, 2, "L", text_color = panelTextColor, bgcolor = panelColor, text_size = dashTextSize)
    table.cell(dash, 1, 2, f_tfLabel(tfTrend), text_color = trendTfBad ? tradeSlColor : panelTextColor, bgcolor = trendTfBad ? color.new(tradeSlColor, errorCellTransparency) : panelColor, text_size = dashTextSize)
    table.cell(dash, 2, 2, trendTfBad ? "확인 불가" : f_stateText(mtfTrendState), text_color = trendTfBad ? tradeSlColor : panelTextColor, bgcolor = trendTfBad ? color.new(tradeSlColor, errorCellTransparency) : f_stateColor(mtfTrendState), text_size = dashTextSize)

    table.cell(dash, 0, 3, "M", text_color = panelTextColor, bgcolor = panelAltColor, text_size = dashTextSize)
    table.cell(dash, 1, 3, f_tfLabel(tfStructure), text_color = structTfBad ? tradeSlColor : panelTextColor, bgcolor = structTfBad ? color.new(tradeSlColor, errorCellTransparency) : panelAltColor, text_size = dashTextSize)
    table.cell(dash, 2, 3, structTfBad ? "확인 불가" : f_stateText(mtfStructureState), text_color = structTfBad ? tradeSlColor : panelTextColor, bgcolor = structTfBad ? color.new(tradeSlColor, errorCellTransparency) : f_stateColor(mtfStructureState), text_size = dashTextSize)

    table.cell(dash, 0, 4, "S", text_color = panelTextColor, bgcolor = panelColor, text_size = dashTextSize)
    table.cell(dash, 1, 4, f_tfLabel(tfEntry), text_color = entryTfBad ? tradeSlColor : panelTextColor, bgcolor = entryTfBad ? color.new(tradeSlColor, errorCellTransparency) : panelColor, text_size = dashTextSize)
    table.cell(dash, 2, 4, entryTfBad ? "확인 불가" : f_stateText(mtfEntryState), text_color = entryTfBad ? tradeSlColor : panelTextColor, bgcolor = entryTfBad ? color.new(tradeSlColor, errorCellTransparency) : f_stateColor(mtfEntryState), text_size = dashTextSize)

    string _momentumText = not useShockBonus ? "사용 안 함" : shockTfBad ? "확인 불가" : (sixHourReturn >= 0 ? "+" : "") + str.tostring(sixHourReturn, "#.##") + "%"
    color _momentumColor = not useShockBonus or shockTfBad ? panelMutedColor : sixHourReturn >= 0 ? bullColor : bearColor
    table.cell(dash, 0, 5, str.tostring(shockLookbackBars) + "개봉", text_color = panelTextColor, bgcolor = panelAltColor, text_size = dashTextSize)
    table.cell(dash, 1, 5, f_tfLabel(shockCalculationTf), text_color = useShockBonus and shockTfBad ? tradeSlColor : panelTextColor, bgcolor = panelAltColor, text_size = dashTextSize)
    table.cell(dash, 2, 5, _momentumText, text_color = _momentumColor, bgcolor = panelAltColor, text_size = dashTextSize)

    table.cell(dash, 0, 6, "▲ 상승", text_color = bullColor, bgcolor = panelColor, text_size = dashTextSize)
    table.cell(dash, 1, 6, str.tostring(longScore) + "/14" + (useEntryTiers ? " · 타점" + str.tostring(longTier) : ""), text_color = panelTextColor, bgcolor = _longScoreBg, text_size = dashTextSize)
    table.cell(dash, 2, 6, _longState, text_color = _longStateColor, bgcolor = panelColor, text_size = dashTextSize)

    table.cell(dash, 0, 7, "▼ 하락", text_color = bearColor, bgcolor = panelAltColor, text_size = dashTextSize)
    table.cell(dash, 1, 7, str.tostring(shortScore) + "/14" + (useEntryTiers ? " · 타점" + str.tostring(shortTier) : ""), text_color = panelTextColor, bgcolor = _shortScoreBg, text_size = dashTextSize)
    table.cell(dash, 2, 7, _shortState, text_color = _shortStateColor, bgcolor = panelAltColor, text_size = dashTextSize)

    string _tradeFooter = not showTradePlan ? entryModeText + " 선별 · 관찰용" :
         tradePlanState == 1 ? (tradePlanDirection == 1 ? "▲" : "▼") + " 계획 진행 · 목표 1 관찰" :
         tradePlanState == 2 ? "목표 1 도달 · 목표 2 관찰" : "계획선 참고용 · 자동 주문 아님"
    table.cell(dash, 0, 8, _tradeFooter,
         text_color = panelMutedColor, bgcolor = panelColor, text_size = size.tiny)

if barstate.islast and not beginnerView and not useDetailedDashboard
    table.clear(dash, 0, 0, 2, 8)

if barstate.islast and useSimpleDashboard
    bool _activeLongPlan = tradePlanState > 0 and tradePlanDirection == 1
    bool _activeShortPlan = tradePlanState > 0 and tradePlanDirection == -1
    bool _recentResult = not na(lastTradeResultBar) and bar_index - lastTradeResultBar <= tradeResultDisplayBars
    bool _newLongReview = tradePlanLongEntryEvent or longUnplannedCandidateEvent
    bool _newShortReview = tradePlanShortEntryEvent or shortUnplannedCandidateEvent
    bool _planOrReview = _activeLongPlan or _activeShortPlan or _newLongReview or _newShortReview
    bool _longPrepare = not _planOrReview and longRaw and longScore > shortScore
    bool _shortPrepare = not _planOrReview and shortRaw and shortScore > longScore
    string _easyTitle = mtfInvalid ? "🔴 시간봉을 확인해요" :
         _recentResult ? "계획 결과 · " + lastTradeResultText :
         _newLongReview ? (useEntryTiers ? "🟢 롱 타점 " + str.tostring(longTier) + "/5" : "🟢 상승 검토 후보") :
         _newShortReview ? (useEntryTiers ? "🔴 숏 타점 " + str.tostring(shortTier) + "/5" : "🔵 하락 검토 후보") :
         _activeLongPlan ? "🟢 상승 계획 확인 중" :
         _activeShortPlan ? "🔵 하락 계획 확인 중" :
         _longPrepare ? "🟡 상승 조건 일부" :
         _shortPrepare ? "🟡 하락 조건 일부" : "⚪ 현재 검토 조건이 부족해요"
    string _easyLine2 = mtfInvalid ? "큰·중간·짧은 흐름 시간 설정을 확인해요" :
         _recentResult ? "현재 계획은 끝났어요 · 다음 검토 후보를 새로 확인해요" :
         _activeLongPlan or _activeShortPlan ?
              (tradePlanState == 2 ? "② 첫 목표 도착 · ③ " + str.tostring(tradePlanTp2, format.mintick) :
               "① 보는 가격 " + str.tostring(tradePlanEntry, format.mintick) + " · ② 첫 목표 " + str.tostring(tradePlanTp1, format.mintick)) :
         _newLongReview ? "확정봉 종가를 보고 빨간 중단선부터 확인해요" :
         _newShortReview ? "아래 방향 검토 조건 · 새 매수 후보가 아니에요" :
         _longPrepare ? "상승 조건 일부만 확인됐어요" :
         _shortPrepare ? "하락 조건 일부만 확인됐어요" : "초록 검토 후보가 나올 때까지 조건을 더 확인해요"
    string _easyLine3 = mtfInvalid ? "지금은 검토하지 않아요" :
         _activeLongPlan or _activeShortPlan ? "✋ 중단선 " + str.tostring(tradePlanSl, format.mintick) + " · 위험폭 " + str.tostring(tradePlanRiskPercent, "#.##") + "% · 자동 주문 아님" :
         "봉이 끝난 뒤 확인 · 자동 주문 아님"
    color _easyColor = mtfInvalid ? tradeSlColor : _recentResult ? lastTradeResultColor : _newLongReview or _activeLongPlan ? bullColor : _newShortReview or _activeShortPlan ? bearColor : _longPrepare or _shortPrepare ? warningColor : panelMutedColor
    color _easyFooterColor = _activeLongPlan or _activeShortPlan ? tradeSlColor : _recentResult ? lastTradeResultColor : panelMutedColor
    table.cell(dash, 0, 0, _easyTitle, text_color = panelTextColor, bgcolor = color.new(_easyColor, panelHeaderTransparency), text_size = dashTextSize)
    table.cell(dash, 0, 1, _easyLine2, text_color = panelTextColor, bgcolor = panelAltColor, text_size = dashTextSize)
    table.cell(dash, 0, 2, _easyLine3, text_color = _easyFooterColor, bgcolor = panelColor, text_size = size.tiny)

if barstate.islast and beginnerView and not useSimpleDashboard
    table.clear(dash, 0, 0, 0, 2)
