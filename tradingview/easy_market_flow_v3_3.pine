//@version=6
indicator(
     "쉬운 시장 흐름 + 코인 찾기 [v3.3]",
     shorttitle = "쉬운 흐름 v3.3",
     overlay = true,
     dynamic_requests = true,
     max_bars_back = 2000,
     max_boxes_count = 200,
     max_lines_count = 500,
     max_labels_count = 500)

// ============================================================================
//  현재 차트 정밀 확인(14점) + 여러 코인 후보 찾기(100점)를 한 지표에 통합.
//  두 점수는 계산 목적이 다르므로 서로 합산하거나 성공 확률로 해석하지 않습니다.
//  기본 권장: 15분 차트 / 큰 흐름 4시간 / 중간 흐름 1시간 / 코인 찾기 15분·1시간.
// ============================================================================

// ─────────────────────────────────────────────────────────────────────────────
// 초보자 빠른 설정
// ─────────────────────────────────────────────────────────────────────────────
groupQuick = "00. 빠른 설정 — 초보자는 여기만"
screenLevel = input.string("아주 쉽게 (추천)", "화면 난이도",
     options = ["아주 쉽게 (추천)", "자세히"],
     tooltip = "아주 쉽게는 조건 부족→조건 일부→검토 후보만 크게 보여줍니다. 자세히는 L·M·S와 조건점수를 모두 보여줍니다.", group = groupQuick)
showBeginnerGuide = input.bool(true, "쉬운 상태 요약표 표시",
     tooltip = "상승·하락 검토 조건을 조건 부족→조건 일부→검토 후보로 설명합니다. 끄면 쉬운 화면의 요약표만 숨깁니다. 자동 주문이나 매매 지시가 아닙니다.", group = groupQuick)
showTechnicalDetailsInEasyMode = input.bool(false, "쉬운 화면에서도 전문 표시 함께 보기",
     tooltip = "끄면 큰·작은 흐름선, 비슷한 고·저점, 복귀 표시, 가격 빈 구간과 반응 구간을 화면에서 숨깁니다. 계산에는 그대로 사용하므로 초보자는 꺼두는 것을 권장합니다.", group = groupQuick)
viewMode = input.string("표시 (추천)", "현재 차트 요약표",
     options = ["표시 (추천)", "숨김"], group = groupQuick)
confirmedOnly = input.bool(true, "일반 모드도 봉 마감으로 확인 (추천)",
     tooltip = "정밀 모드와 최종 검토 후보는 항상 봉 마감 후 확정됩니다. 끄면 일반 모드의 요약 조건만 봉 안에서 변할 수 있습니다.", group = groupQuick)
showSignals = input.bool(true, "현재 차트 검토 후보 표시",
     tooltip = "현재 설정의 조건과 최소 점수를 처음 함께 충족한 확정봉을 표시합니다. 실제 진입 지시나 수익 보장이 아닙니다.", group = groupQuick)
entryFilterMode = input.string("정밀 (추천)", "검토 후보 선별 모드",
     options = ["정밀 (추천)", "일반"],
     tooltip = "정밀 모드는 추가 조건으로 검토 후보 수를 줄입니다. 정확도나 수익을 보장하지 않습니다. 일반 모드는 기존 점수·순서·구간 조건을 사용합니다.", group = groupQuick)
signalScoreMin = input.int(8, "검토 후보 최소 조건점수 (14점 만점)", minval = 1, maxval = 14,
     tooltip = "미리 정한 조건별 점수를 더한 값이며 조건 개수나 성공 확률이 아닙니다.", group = groupQuick)
// scanMinimumScore = input.int(65, "코인 관심 점수 기준 (100점 만점)", minval = 0, maxval = 100,
//      tooltip = "코인끼리 조건을 비교하기 위한 점수이며 성공 확률이 아닙니다.", group = groupQuick)
// scanStrongScore = input.int(75, "검토 후보 기준점수 (100점 만점)", minval = 0, maxval = 100,
//      tooltip = "복귀→돌파와 구간 재접촉까지 충족했을 때 적용할 별도 기준입니다.", group = groupQuick)
// scanRowsInput = input.int(6, "표시할 코인 수", minval = 3, maxval = 16,
//      tooltip = "작은 표는 3~6개가 보기 좋습니다.", group = groupQuick)
// scanOnlyInterested = input.bool(false, "관심 기준 이상인 코인만 목록에 표시", group = groupQuick)

bool beginnerView = screenLevel == "아주 쉽게 (추천)"
bool showDetailVisuals = not beginnerView or showTechnicalDetailsInEasyMode
bool showDashboard = viewMode == "표시 (추천)"
bool showScanner = false  // 코인 탐색기 비활성화 (아래 스캐너 코드 전체 주석 처리됨)

groupVisual = "01. 화면과 색상"
dashPositionInput = input.string("왼쪽 위", "현재 차트 요약표 위치",
     options = ["왼쪽 위", "오른쪽 위", "왼쪽 아래", "오른쪽 아래"], group = groupVisual)
// scanPositionInput = input.string("오른쪽 위", "코인 찾기 표 위치",
//      options = ["왼쪽 위", "오른쪽 위", "왼쪽 아래", "오른쪽 아래"], group = groupVisual)
dashSizeInput = input.string("작게", "표 글자 크기", options = ["아주 작게", "작게", "보통"], group = groupVisual)
signalLabelSizeInput = input.string("보통", "상승·하락 검토 후보 글자 크기", options = ["아주 작게", "작게", "보통", "크게"], group = groupVisual)
planLabelSizeInput = input.string("작게", "계획 가격표 글자 크기", options = ["아주 작게", "작게", "보통", "크게"], group = groupVisual)
zoneTextSizeInput = input.string("아주 작게", "관심 구간 글자 크기", options = ["아주 작게", "작게", "보통"], group = groupVisual)
showZoneText = input.bool(true, "관심 구간 안에 쉬운 설명 표시", inline = "detail", group = groupVisual)
paintSignalBar = input.bool(true, "검토 후보 캔들 강조", inline = "detail", group = groupVisual)

groupPalette = "01A. 색상 — 모든 주요 요소"
bullColor = input.color(color.rgb(0, 211, 149), "상승 방향", inline = "direction", group = groupPalette)
bearColor = input.color(color.rgb(59, 130, 246), "하락 방향", inline = "direction", group = groupPalette)
accentColor = input.color(color.rgb(124, 92, 252), "중립·강조", inline = "direction", group = groupPalette)
tradeEntryColor = input.color(color.rgb(124, 92, 252), "보는 가격 (ENTRY)", inline = "plan", group = groupPalette)
tradeTp1Color = input.color(color.rgb(34, 211, 238), "목표 1", inline = "plan", group = groupPalette)
tradeTp2Color = input.color(color.rgb(34, 197, 94), "목표 2", inline = "plan", group = groupPalette)
tradeSlColor = input.color(color.rgb(255, 77, 109), "계획 중단선 (SL)", inline = "plan", group = groupPalette)
warningColor = color.rgb(255, 179, 71)
bullFvgColor = color.rgb(0, 188, 212)
bearFvgColor = color.rgb(96, 165, 250)
vwapColor = color.rgb(192, 132, 252)
panelColor = color.rgb(14, 19, 29)
panelAltColor = color.rgb(23, 30, 44)
panelBorderColor = color.rgb(46, 57, 77)
panelTextColor = color.rgb(235, 239, 247)
panelMutedColor = color.rgb(143, 153, 173)

groupLines = "01B. 선 모양·굵기"
vwapWidth = 2
vwapLineStyleInput = "실선"
swingLineStyleInput = "실선"
swingLineWidth = 2
internalLineStyleInput = "점선"
internalLineWidth = 1
equalLineStyleInput = "도트"
equalLineWidth = 1
rangeLineStyleInput = "실선"
rangeLineWidth = 1
tradeEntryLineStyleInput = "실선"
tradeEntryLineWidth = 3
tradeTp1LineStyleInput = "점선"
tradeTp1LineWidth = 2
tradeTp2LineStyleInput = "점선"
tradeTp2LineWidth = 2
tradeSlLineStyleInput = "실선"
tradeSlLineWidth = 3
zoneBorderStyleInput = "실선"
zoneBorderWidth = 1
tradeAreaBorderStyleInput = "실선"
tradeAreaBorderWidth = 1
panelFrameWidth = 1
panelGridWidth = 1

groupOpacity = "01C. 투명도 — 0=진하게, 100=안 보임"
signalLabelTransparency = 0
signalBarTransparency = 18
signalBgTransparency = 92
vwapTransparency = 5
swingLineTransparency = 12
internalLineTransparency = 58
equalLineTransparency = 18
rangeLineTransparency = 28
rangeFillTransparency = 94
zoneBorderTransparency = 25
zoneFillTransparency = 88
inactiveZoneTransparency = 94
zoneTextTransparency = 8
tradeLabelTransparency = 5
tradeRewardTransparency = 93
tradeRiskTransparency = 91
tradeAreaBorderTransparency = 76
obBaseTransparency = 91
obMinTransparency = 72
obVolumeOpacityCap = 3.0
obVolumeOpacityStep = 6.0
panelBgTransparency = 4
panelHeaderTransparency = 35
panelFrameTransparency = 0
panelGridTransparency = 35
directionCellTransparency = 18
interestCellTransparency = 28
mutedCellTransparency = 76
errorCellTransparency = 72

string dashPosition = dashPositionInput == "오른쪽 위" ? position.top_right :
     dashPositionInput == "왼쪽 아래" ? position.bottom_left :
     dashPositionInput == "오른쪽 아래" ? position.bottom_right : position.top_left
// bool panelPositionsSame = showDashboard and showScanner and scanPositionInput == dashPositionInput
// string scanPosition = panelPositionsSame ?
//      (scanPositionInput == "왼쪽 위" ? position.top_right :
//       scanPositionInput == "오른쪽 위" ? position.top_left :
//       scanPositionInput == "왼쪽 아래" ? position.bottom_right : position.bottom_left) :
//      scanPositionInput == "왼쪽 위" ? position.top_left :
//      scanPositionInput == "왼쪽 아래" ? position.bottom_left :
//      scanPositionInput == "오른쪽 아래" ? position.bottom_right : position.top_right
string dashTextSize = dashSizeInput == "아주 작게" ? size.tiny : dashSizeInput == "보통" ? size.normal : size.small

groupCore = "02. 현재 차트 — 기본 조건"
requireSequence = input.bool(true, "고·저점 복귀 → 흐름 돌파 순서 필수",
     tooltip = "일반 모드 설정입니다. 정밀 모드는 더 강한 순서 조건을 항상 확인합니다.", group = groupCore)
requireZoneTouch = input.bool(true, "관심 구간 재접촉 필수",
     tooltip = "일반 모드 설정입니다. 정밀 모드는 구조 돌파 뒤 만들어진 구간의 재접촉과 반응봉을 항상 확인합니다.", group = groupCore)
setupWindow = input.int(40, "조건 연결 허용 기간 (봉)", minval = 5, maxval = 300,
     tooltip = "고·저점 복귀 후 흐름 돌파가 이어져야 하는 최대 봉 수입니다.", group = groupCore)

groupPrecision = "02A. 현재 차트 — 정밀 검토 후보"
precisionScoreMin = input.int(10, "정밀 최소점수 (14점)", minval = 8, maxval = 14,
     tooltip = "일반 최소점수와 이 값 중 더 높은 기준을 사용합니다. 기본 10점은 후보를 더 엄격하게 거릅니다.", group = groupPrecision)
precisionScoreGap = input.int(2, "상승·하락 최소 점수차", minval = 1, maxval = 6,
     tooltip = "상승·하락 점수가 비슷한 애매한 상황을 제외합니다.", group = groupPrecision)
precisionUseVolume = input.bool(false, "거래량 배수 조건 사용",
     tooltip = "반응봉 거래량이 최근 평균의 설정 배수 이상인지 확인합니다. 거래량 자료가 없는 종목은 이 조건을 건너뜁니다.", group = groupPrecision)
precisionVolumeRatio = input.float(1.2, "최소 거래량 배수", minval = 0.5, maxval = 5.0, step = 0.1,
     tooltip = "1.2는 최근 평균 거래량의 1.2배를 뜻합니다.", group = groupPrecision)
precisionUseVolatility = input.bool(true, "큰 변동·평균선 이격 제외",
     tooltip = "평균보다 너무 작거나 큰 변동, 큰 캔들, 빠른 평균선에서 멀어진 봉을 제외합니다.", group = groupPrecision)
precisionCooldownBars = input.int(5, "같은 방향 재표시 대기 (봉)", minval = 0, maxval = 100,
     tooltip = "같은 방향 후보가 짧은 시간에 반복 표시되는 것을 줄입니다. 15분 차트의 5봉은 75분입니다.", group = groupPrecision)

groupPrecisionAdvanced = "02AA. 정밀 검토 후보 — 세부값"
precisionRequireTrend = true
precisionRequireStructure = true
precisionRequireStrongSequence = true
precisionRequireLinkedZone = true
precisionRequireReaction = true
precisionBodyMin = 0.35
precisionCloseStrength = 0.65
atrBaselineLen = 50
precisionAtrMin = 0.75
precisionAtrMax = 2.50
precisionMaxRangeAtr = 2.00
precisionMaxChaseAtr = 1.25
structureBreakBufferAtr = 0.00
sweepMinDepthAtr = 0.00
sweepReturnBufferAtr = 0.00
zoneMinDepthPct = 0.00
fvgFillPct = 100.00

groupEntryTier = "02C. 확정 타점 등급 — 롱/숏 직접 표시"
useEntryTiers = input.bool(true, "타점을 1~5 신뢰 등급으로 잡기 (권장)",
     tooltip = "켜면 정밀/일반 대신 신뢰 등급으로 타점을 잡습니다. 1=낮은 신뢰, 5=거의 완벽. 각 타점에 롱/숏과 TP1·TP2·SL을 함께 표시합니다. 자동 주문이 아닙니다.", group = groupEntryTier)
entryMinTier = input.int(3, "표시할 최소 타점 등급 (1~5)", minval = 1, maxval = 5,
     tooltip = "이 등급 이상만 표시합니다. 3=신뢰 이상. 신호가 너무 적으면 2로, 너무 많으면 4로 조정하세요.", group = groupEntryTier)
showTierStars = input.bool(false, "별점(★) 함께 표시", group = groupEntryTier)
tierBound2 = input.int(40, "2등급 시작 점수", minval = 1, maxval = 99, inline = "tier", group = groupEntryTier)
tierBound3 = input.int(58, "3등급", minval = 1, maxval = 99, inline = "tier", group = groupEntryTier)
tierBound4 = input.int(74, "4등급", minval = 1, maxval = 99, inline = "tier2", group = groupEntryTier)
tierBound5 = input.int(88, "5등급", minval = 1, maxval = 99, inline = "tier2", group = groupEntryTier)

groupTradePlan = "02B. 현재 차트 — 참고 계획선"
showTradePlan = input.bool(true, "참고 계획선 표시 (자동 주문 아님)",
     tooltip = "검토 후보봉의 종가를 보는 가격으로 삼아 첫 목표·마지막 목표·계획 중단선을 계산해 표시합니다. 끄면 계획선 추적과 관련 알림도 함께 꺼집니다. 실제 주문·체결·청산을 실행하거나 수익을 보장하지 않습니다.", group = groupTradePlan)
tradeSlAtrBuffer = input.float(0.20, "중단선 구간 밖 여유 (ATR)", minval = 0.0, maxval = 3.0, step = 0.05,
     tooltip = "상승은 연결 구간과 후보봉 저가 아래, 하락은 연결 구간과 후보봉 고가 위에 이 ATR 여유를 더합니다.", group = groupTradePlan)
tradeMinRiskAtr = input.float(0.50, "최소 위험거리 (ATR)", minval = 0.10, maxval = 3.0, step = 0.10,
     tooltip = "손절 기준이 진입 기준에 지나치게 가까워지는 것을 막습니다.", group = groupTradePlan)
tradeMaxRiskAtr = input.float(3.00, "최대 위험거리 (ATR)", minval = 0.50, maxval = 10.0, step = 0.25,
     tooltip = "필요한 손절 거리가 이 값보다 넓으면 무리한 계획선을 만들지 않고 생략합니다. 최소 위험거리보다 작게 입력하면 최소 위험거리 값을 실제 상한으로 사용합니다.", group = groupTradePlan)
tradeTp1R = input.float(1.0, "첫 목표 배수 (TP1·R)", minval = 0.25, maxval = 5.0, step = 0.25,
     tooltip = "1R은 진입 기준과 손절 기준 사이의 거리입니다.", group = groupTradePlan)
tradeTp2R = input.float(2.0, "마지막 목표 배수 (TP2·R)", minval = 0.50, maxval = 10.0, step = 0.25,
     tooltip = "TP2가 TP1보다 작게 설정되면 코드가 TP1보다 0.25R 높은 값으로 보정합니다.", group = groupTradePlan)
tradeMaxHoldBars = input.int(40, "계획선 최대 추적 기간 (봉)", minval = 5, maxval = 500,
     tooltip = "이 기간 안에 마지막 목표 또는 계획 중단선이 닿지 않으면 관찰 기간 종료로 처리합니다. 15분 차트의 40봉은 10시간입니다.", group = groupTradePlan)
tradePlanRightBars = input.int(12, "가격표 오른쪽 여백 (봉)", minval = 2, maxval = 50, group = groupTradePlan)
tradePlanHistoryCount = input.int(3, "과거 표시 켤 때 남길 타점 개수", minval = 1, maxval = 10,
     tooltip = "'과거 타점도 함께 표시'를 켰을 때 최근 몇 개까지 남길지 정합니다.", group = groupTradePlan)
showPastPositions = input.bool(false, "과거 타점도 함께 표시",
     tooltip = "끄면 최근 타점 1개만 표시합니다(기본). 켜면 위 개수만큼 과거 타점을 남깁니다.", group = groupTradePlan)
showTradeLabels = input.bool(true, "가격 라벨 표시 (진입·TP·SL 글자)",
     tooltip = "끄면 선과 영역은 남기고 글자 라벨만 숨겨 화면을 깔끔하게 합니다.", group = groupTradePlan)
showTradeAreaBoxes = input.bool(false, "목표·손절 영역 색칠 박스",
     tooltip = "끄면 진입·TP·SL 가로선만 표시합니다(기본, 깔끔). 켜면 목표·손절 영역을 반투명 색으로 채웁니다.", group = groupTradePlan)
tradeResultDisplayBars = input.int(3, "종료 결과를 요약표에 유지 (봉)", minval = 1, maxval = 50,
