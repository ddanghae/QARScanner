            float _touchThreshold = _bottom + _height * effectiveFvgTouchDepthPct / 100.0
            float _fillThreshold = _bottom + _height * fvgFillPct / 100.0
            bool _overlap = high >= _bottom and low <= _top
            bool _filled = bar_index > _createdBar and high >= _fillThreshold
            bool _touch = bar_index > _createdBar and _overlap and high >= _touchThreshold
            bool _validTouch = _touch and not _filled
            inBearFvg := inBearFvg or _validTouch
            if barClosed and _filled
                if deleteFilledFVG
                    box.delete(_b)
                else
                    box.set_right(_b, bar_index)
                    box.set_border_color(_b, color.new(panelMutedColor, showDetailVisuals ? math.max(0, inactiveZoneTransparency - 22) : 100))
                    box.set_bgcolor(_b, color.new(panelMutedColor, showDetailVisuals ? inactiveZoneTransparency : 100))
                    box.set_text(_b, showDetailVisuals and showZoneText ? "채워진 구간" : "")
                    box.set_text_color(_b, color.new(panelMutedColor, showDetailVisuals ? math.max(0, inactiveZoneTransparency - 59) : 100))
